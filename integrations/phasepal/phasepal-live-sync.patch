+// #Assets/_PhasePal/Scripts/Services/ChatV2/Platform/ChatV2ExternalConversationService.cs
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.IO;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using PhasePal.Security;
+using PhasePal.Services.ChatV2.Core;
+
+namespace PhasePal.Services.ChatV2.Platform
+{
+    /// <summary>ChatV2 host-owned receiver lifetime. Changes are published by Tick on Unity's thread.</summary>
+    public sealed class ChatV2ExternalConversationService : IChatV2ExternalConversations
+    {
+        private readonly ChatV2ExternalConversationStore _store;
+        private readonly ChatV2LocalConversationSync _local;
+        private readonly IChatV2ExternalMemorySecretStore _secrets;
+        private readonly string _settingsPath;
+        private readonly string _scope;
+        private readonly SemaphoreSlim _settingsWriter = new SemaphoreSlim(1, 1);
+        private readonly ConcurrentQueue<string> _changedSessions = new ConcurrentQueue<string>();
+        private readonly CancellationTokenSource _hostLifetime = new CancellationTokenSource();
+        private ChatV2ExternalConversationReceiver _receiver;
+        private CancellationTokenSource _localLifetime;
+        private Task _localWorker;
+        private string _token, _characterId, _characterName;
+        private int _generation, _dirty;
+        private volatile bool _disposed, _historyConsent, _enabled, _suspended;
+        private string _statusText = "External conversation sync is off.";
+        public event Action Changed;
+        public bool Enabled => _enabled;
+        public bool Ready => _receiver != null && _enabled && !_disposed;
+        public string StatusText => _statusText;
+
+        public ChatV2ExternalConversationService(IChatV2HistoryStore history, string persistentDataPath,
+            IChatV2ExternalMemorySecretStore secrets = null, ChatV2LocalConversationSync local = null)
+        {
+            _store = new ChatV2ExternalConversationStore(history, persistentDataPath);
+            _local = local ?? new ChatV2LocalConversationSync(persistentDataPath);
+            _scope = ChatV2ExternalConversationStore.Hash(Path.GetFullPath(persistentDataPath)).Substring(0, 24);
+            _secrets = secrets ?? new ChatV2ExternalMemoryOsSecretStore(
+                "PhasePal.OpenChatLink." + _scope, "OpenChatLink");
+            var paths = new PhasePalOwnedPathService(persistentDataPath);
+            if (!paths.TryResolveIdentifierDirectory("Settings", out string settings) ||
+                !paths.TryResolveDirectChildFile(settings, "external_conversation_settings.json", out _settingsPath))
+                throw new IOException("External conversation settings path is unavailable.");
+        }
+
+        /// <summary>Loads scoped preferences and resumes sync while chat-history consent allows it.</summary>
+        public async Task ResumeAsync(bool historyConsent)
+        {
+            if (_disposed) return;
+            int generation = Interlocked.Increment(ref _generation);
+            _suspended = false;
+            StopReceiver();
+            _historyConsent = historyConsent;
+            try
+            {
+                JObject saved = await Task.Run(() => {
+                    _store.Initialize();
+                    return File.Exists(_settingsPath) ? JObject.Parse(File.ReadAllText(_settingsPath)) : null;
+                });
+                if (_disposed || _suspended || generation != _generation) return;
+                if (saved != null && (int?)saved["schema"] != 1) throw new InvalidDataException();
+                bool enabled = (bool?)saved?["enabled"] ?? false;
+                _enabled = enabled;
+                _characterId = (string)saved?["characterId"];
+                _characterName = (string)saved?["characterName"];
+                if (enabled && !historyConsent)
+                { _enabled = true; SetStatus("External sync is paused because Store Chat History is off."); }
+                else if (enabled) await SetEnabledAsync(true, _characterId, _characterName);
+                else MarkChanged();
+            }
+            catch (Exception) { if (!_disposed && !_suspended) SetStatus("External sync could not start. Check local settings and try again."); }
+        }
+
+        /// <inheritdoc />
+        public async Task SetEnabledAsync(bool enabled, string characterId, string characterName)
+        {
+            if (_disposed || _suspended) return;
+            int generation = Interlocked.Increment(ref _generation);
+            StopReceiver();
+            _enabled = enabled;
+            SetStatus(enabled ? "Connecting OpenChatLink…" : "External conversation sync is off.");
+            await _settingsWriter.WaitAsync(_hostLifetime.Token);
+            try
+            {
+                if (generation != _generation || _disposed || _suspended) return;
+                if (enabled && (!_historyConsent || !PhasePalOwnedPathService.IsStrictIdentifier(characterId)))
+                { _enabled = false; SetStatus("Enable Store Chat History and select an avatar before connecting."); return; }
+                _characterId = characterId; _characterName = characterName ?? string.Empty;
+                await Task.Run(() => {
+                    Directory.CreateDirectory(Path.GetDirectoryName(_settingsPath));
+                    string temporary = _settingsPath + ".tmp";
+                    File.WriteAllText(temporary, JsonConvert.SerializeObject(new {
+                        schema = 1, enabled, characterId, characterName = _characterName }));
+                    if (File.Exists(_settingsPath)) File.Replace(temporary, _settingsPath, null);
+                    else File.Move(temporary, _settingsPath);
+                });
+                if (generation != _generation || _disposed || _suspended || (enabled && !_historyConsent)) return;
+                if (!enabled)
+                { await _secrets.DeleteAsync(); _token = null; return; }
+                if (!await Task.Run(() => _secrets.IsAvailable))
+                { SetStatus("Secure storage is unavailable. External sync cannot start."); return; }
+                ChatV2ExternalMemorySecretLoadResult loaded = await _secrets.LoadAsync();
+                if (generation != _generation || _disposed || _suspended || !_historyConsent) return;
+                if (!loaded.Succeeded) { SetStatus("Could not read the saved connection. Try again."); return; }
+                string token = loaded.Secret;
+                if (string.IsNullOrEmpty(token))
+                {
+                    var bytes = new byte[32];
+                    using (RandomNumberGenerator random = RandomNumberGenerator.Create()) random.GetBytes(bytes);
+                    token = BitConverter.ToString(bytes).Replace("-", "").ToLowerInvariant();
+                    if (!await _secrets.SaveAsync(token))
+                    { SetStatus("Could not save the connection securely. Try again."); return; }
+                }
+                if (generation != _generation || _disposed || _suspended || !_historyConsent) return;
+                string targetId = _characterId, targetName = _characterName;
+                _token = token;
+                _receiver = new ChatV2ExternalConversationReceiver(token,
+                    () => new { protocol = ChatV2ExternalConversationReceiver.PROTOCOL,
+                        connectionId = _scope + ":" + targetId, targetName },
+                    async (conversation, cancellation) => {
+                        if (generation != _generation || !_historyConsent) throw new OperationCanceledException();
+                        var result = await _store.ImportAsync(conversation, targetId, targetName, cancellation);
+                        if (generation == _generation && !cancellation.IsCancellationRequested)
+                        { if (result.Changed) _changedSessions.Enqueue(result.SessionId); SetStatus("External sync is connected. New chats go to " + targetName + "."); }
+                        return new { protocol = ChatV2ExternalConversationReceiver.PROTOCOL,
+                            accepted = result.Accepted, conflict = result.Conflict };
+                    }, async (source, action, body, cancellation) => {
+                        if (generation != _generation || !_historyConsent) throw new OperationCanceledException();
+                        if (action == "catalog") return await Task.Run(() => _local.Catalog(source, (int)body["offset"], cancellation), cancellation);
+                        if (action == "preferences") {
+                            if (body.Count != 1 || !(body["preferences"] is JObject preferences)) throw new InvalidDataException();
+                            await _local.ConfigureAsync(source, preferences, cancellation);
+                        }
+                        else if (body.Count != 0) throw new InvalidDataException();
+                        else if (action == "sync") await _local.RequestSyncAsync(source, cancellation);
+                        else if (action == "pause") await _local.PauseAsync(cancellation);
+                        return new { protocol = ChatV2ExternalConversationReceiver.PROTOCOL, queued = action == "sync" };
+                    });
+                _receiver.Start();
+                _localLifetime = CancellationTokenSource.CreateLinkedTokenSource(_hostLifetime.Token);
+                CancellationToken localToken = _localLifetime.Token;
+                _localWorker = Task.Run(() => RunLocalAsync(generation, targetId, targetName, localToken));
+                SetStatus("Ready. Copy the connection code into the OpenChatLink extension.");
+            }
+            catch (OperationCanceledException) { }
+            catch (Exception)
+            { StopReceiver(); SetStatus("The local sync connection could not start. Close another Phase Pal instance and try again."); }
+            finally { _settingsWriter.Release(); }
+        }
+
+        /// <inheritdoc />
+        public string GetConnectionCode()
+        {
+            if (!Ready || string.IsNullOrEmpty(_token)) return string.Empty;
+            string json = JsonConvert.SerializeObject(new { v = 1, port = ChatV2ExternalConversationReceiver.PORT, token = _token });
+            return "ocl1." + Convert.ToBase64String(Encoding.UTF8.GetBytes(json)).TrimEnd('=').Replace('+', '-').Replace('/', '_');
+        }
+
+        /// <inheritdoc />
+        public ChatV2ExternalConversationInfo GetSessionInfo(string sessionId) => _store.GetInfo(sessionId);
+        /// <inheritdoc />
+        public bool CanWriteSession(string sessionId) => _store.CanWrite(sessionId);
+        /// <inheritdoc />
+        public Task<string> CreateLocalCopyAsync(string sessionId, string characterId, CancellationToken token)
+        {
+            if (!_historyConsent) throw new InvalidOperationException("Chat history storage is disabled.");
+            return Task.Run(async () => {
+                using (var linked = CancellationTokenSource.CreateLinkedTokenSource(token, _hostLifetime.Token))
+                    return await _store.CreateLocalCopyAsync(sessionId, characterId, linked.Token);
+            }, token);
+        }
+
+        private void SetStatus(string text) { _statusText = text; MarkChanged(); }
+        private void MarkChanged() => Interlocked.Exchange(ref _dirty, 1);
+        /// <summary>Publishes completed imports and consent changes on the Unity thread.</summary>
+        public IReadOnlyList<string> Tick(bool historyConsent)
+        {
+            if (_historyConsent != historyConsent)
+            {
+                _historyConsent = historyConsent;
+                if (!historyConsent) { Interlocked.Increment(ref _generation); StopReceiver(); SetStatus("External sync is paused because Store Chat History is off."); }
+                else if (_enabled && _receiver == null) _ = SetEnabledAsync(true, _characterId, _characterName);
+            }
+            List<string> changed = null;
+            while (_changedSessions.TryDequeue(out string session))
+            { if (changed == null) changed = new List<string>(); changed.Add(session); }
+            if (Interlocked.Exchange(ref _dirty, 0) != 0) Changed?.Invoke();
+            return changed == null ? (IReadOnlyList<string>)Array.Empty<string>() : changed;
+        }
+        private async Task RunLocalAsync(int generation, string characterId, string characterName, CancellationToken token)
+        {
+            try {
+                while (!token.IsCancellationRequested && generation == _generation)
+                {
+                    try {
+                        int failures = await _local.RunAsync(async (conversation, cancellation) => {
+                            if (generation != _generation || !_historyConsent) throw new OperationCanceledException();
+                            var result = await _store.ImportAsync(conversation, characterId, characterName, cancellation);
+                            if (generation == _generation && !cancellation.IsCancellationRequested && result.Changed)
+                            { _changedSessions.Enqueue(result.SessionId); SetStatus("Local conversation history updated. New chats go to " + characterName + "."); }
+                            return !result.Conflict;
+                        }, token).ConfigureAwait(false);
+                        if (failures > 0 && generation == _generation)
+                            SetStatus("Some local chats could not sync or exceeded the size limit. Automatic sync retries; in manual mode, select Sync now to retry.");
+                    } catch (OperationCanceledException) { throw; }
+                    catch (Exception) { if (generation == _generation) SetStatus("Some local chats could not sync. Check your OpenChatLink selections and try again."); }
+                    await Task.Delay(5000, token).ConfigureAwait(false);
+                }
+            } catch (OperationCanceledException) { }
+        }
+
+        private void StopReceiver()
+        {
+            _receiver?.Dispose(); _receiver = null;
+            CancellationTokenSource lifetime = _localLifetime; Task worker = _localWorker;
+            _localLifetime = null; _localWorker = null;
+            if (lifetime != null) { lifetime.Cancel(); _ = DrainLocalAsync(worker, lifetime); }
+        }
+
+        private static async Task DrainLocalAsync(Task worker, CancellationTokenSource lifetime)
+        {
+            try { if (worker != null) await worker.ConfigureAwait(false); }
+            catch (Exception) { }
+            finally { lifetime.Dispose(); }
+        }
+        /// <summary>Stops reception and rejects pending startup work without changing saved preferences.</summary>
+        public void Suspend() { _suspended = true; Interlocked.Increment(ref _generation); StopReceiver(); }
+        /// <summary>Cancels the host lifetime and closes all receiver work.</summary>
+        public void Dispose()
+        {
+            if (_disposed) return;
+            _disposed = true; _hostLifetime.Cancel(); Suspend();
+        }
+    }
+}
diff --git a/Phase Pal/Assets/_PhasePal/Scripts/Services/ChatV2/Platform/ChatV2ExternalConversationStore.cs b/Phase Pal/Assets/_PhasePal/Scripts/Services/ChatV2/Platform/ChatV2ExternalConversationStore.cs
