+        private sealed class Secrets : IChatV2ExternalMemorySecretStore
+        {
+            public bool IsAvailable { get; set; } = true;
+            public string Secret = new string('b', 64);
+            public TaskCompletionSource<ChatV2ExternalMemorySecretLoadResult> Pending;
+            public readonly TaskCompletionSource<bool> LoadStarted = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+            public Task<ChatV2ExternalMemorySecretLoadResult> LoadAsync()
+            {
+                LoadStarted.TrySetResult(true);
+                return Pending?.Task ?? Task.FromResult(new ChatV2ExternalMemorySecretLoadResult(true, Secret));
+            }
+            public Task<bool> SaveAsync(string secret) { Secret = secret; return Task.FromResult(true); }
+            public Task<bool> DeleteAsync() { Secret = null; return Task.FromResult(true); }
+        }
