+        public sealed class Record
+        {
+            public string SessionId, Source, ExternalId, AccountId, AssignedCharacterId, AssignedCharacterName;
+            public string SourceTitle, HistoryHash, OriginalSessionId;
+            public string PendingHistoryHash, PendingTitle;
+            public bool Deleted;
+        }
+
+        public ChatV2ExternalConversationStore(IChatV2HistoryStore history, string persistentDataPath)
