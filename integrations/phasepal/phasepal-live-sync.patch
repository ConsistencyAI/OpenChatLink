+// #Assets/_PhasePal/Scripts/Services/ChatV2/Platform/ChatV2LibrarySharedSettingsFactory.cs
+using UnityEngine;
+using UnityEngine.UIElements;
+using System;
+using PhasePal.Services.InGameSettings.Core;
+using PhasePal.Services.ChatV2.Toolkit;
+
+namespace PhasePal.Services.ChatV2.Platform
+{
+    /// <summary>Uses the single installed ChatV2 owner for settings opened from Library.</summary>
+    public sealed class ChatV2LibrarySharedSettingsFactory : ILibrarySharedSettingsFactory
+    {
+        public ILibrarySharedSettingsHost Create(VisualElement root, Action close, Action showLibraryOptions)
+        {
+            ChatV2RuntimeHostController host = FindHost();
+            if (host == null)
+            {
+                ChatV2RuntimeAutoBootstrapper.EnsureRuntimeHost(openAfterCreate: false);
+                host = FindHost();
+            }
+            if (host != null) return host.CreateLibrarySettingsHost(root, close, showLibraryOptions);
+            throw new InvalidOperationException("The shared application settings owner is unavailable.");
+        }
+
+        private static ChatV2RuntimeHostController FindHost()
+        {
+            foreach (var host in UnityEngine.Object.FindObjectsByType<ChatV2RuntimeHostController>(
+                         FindObjectsInactive.Include, FindObjectsSortMode.None))
+                if (host.gameObject.scene.IsValid() && host.gameObject.scene.isLoaded) return host;
+            return null;
+        }
+    }
+
+    internal sealed class ChatV2LibrarySharedSettingsHost : ILibrarySharedSettingsHost
+    {
+        private readonly ChatV2SharedSettingsPanelView _view;
+        private readonly ChatV2RuntimeActionCoordinator _actions;
+        private readonly Action _close;
+        private readonly Action _showLibraryOptions;
+        private readonly ChatV2ShellEventHandlerFactory _events;
+        private readonly Func<Core.ChatV2StatusEntry> _status;
+        private readonly VisualElement _root;
+        private IDisposable _viewLease;
+        private float _nextRefresh;
+        private bool _disposed;
+
+        public bool IsValid => !_disposed && !_view.IsDisposed;
+
+        public ChatV2LibrarySharedSettingsHost(VisualElement root, ChatV2RuntimeActionCoordinator actions,
+            ChatV2ShellEventHandlerFactory events, Action close, Action showLibraryOptions,
+            global::IHotkeyService hotkeys, Core.IChatV2ExternalConversations externalConversations,
+            Action<bool> toggleExternalConversations, Func<Core.ChatV2StatusEntry> status, Action playClickSound = null)
+        {
+            _root = root;
+            _actions = actions;
+            _close = close;
+            _showLibraryOptions = showLibraryOptions;
+            _events = events;
+            _status = status;
+            _view = new ChatV2SharedSettingsPanelView(root, hotkeys, externalConversations, toggleExternalConversations,
+                playClickSound);
+            ChatV2SettingsPanelEventBinder.Bind(_view.Presenter, events.CreateHandlers());
+            _view.CloseRequested += HandleClose;
+            _view.LibraryOptionsRequested += HandleLibraryOptions;
+        }
+
+        public void Open()
+        {
+            if (!IsValid) return;
+            _viewLease?.Dispose();
+            _viewLease = _actions.BindSettingsView(_view);
+            _actions.HandleSettingsRequested();
+            _view.ApplyStatus(_status?.Invoke());
+            _nextRefresh = Time.unscaledTime + 1f;
+        }
+
+        public void Close()
+        {
+            if (_disposed) return;
+            _view.CloseSettingsPanel();
+            _events.CancelFilePickers();
+            _events.ClearPendingSettingsAnalytics();
+            _viewLease?.Dispose();
+            _viewLease = null;
+        }
+
+        private void HandleClose() { Close(); _close?.Invoke(); }
+        private void HandleLibraryOptions() { Close(); _showLibraryOptions?.Invoke(); }
+
+        public void Tick()
+        {
+            if (!IsValid || !_view.IsSettingsPanelOpen) return;
+            for (VisualElement parent = _root; parent != null; parent = parent.parent)
+                if (parent.resolvedStyle.display == DisplayStyle.None) { Close(); return; }
+            _events.TickSettingsAnalytics();
+            _view.ApplyStatus(_status?.Invoke());
+            if (Time.unscaledTime < _nextRefresh) return;
+            _nextRefresh = Time.unscaledTime + 1f;
+            _actions.RefreshSettingsPanel();
+        }
+
+        public void Dispose()
+        {
+            if (_disposed) return;
+            Close();
+            _disposed = true;
+            _view.CloseRequested -= HandleClose;
+            _view.LibraryOptionsRequested -= HandleLibraryOptions;
+            _view.Dispose();
+        }
+    }
+}
