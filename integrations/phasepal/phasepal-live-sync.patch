 using System.Threading.Tasks;
@@ -16,11 +18,69 @@ using PhasePal.Services.DependencyInjection;
 using PhasePal.Services.Platform.Core;
 using PhasePal.Services.PromptLocalization.Core;
 using UnityEngine;
+using Object = UnityEngine.Object;

 namespace PhasePal.Tests.ChatV2.EditMode
 {
     public sealed class ChatV2RuntimeHostTests
     {
+        [TestCase(false)]
+        [TestCase(true)]
+        public void ExternalConversationRefresh_WaitsForAttachmentsAndDiscardsStaleSelection(bool changeSelection)
+        {
+            string root = Path.Combine(Path.GetTempPath(), "phasepal-external-refresh-" + Guid.NewGuid().ToString("N"));
+            if (Application.platform == RuntimePlatform.OSXEditor && root.StartsWith("/var/", StringComparison.Ordinal)) root = "/private" + root;
+            var gameObject = new GameObject("External conversation refresh test");
+            gameObject.SetActive(false);
+            ChatV2ExternalConversationService external = null;
+            try
+            {
+                var host = gameObject.AddComponent<ChatV2RuntimeHostController>();
+                var store = new ChatV2FileHistoryStore(root, "original");
+                var history = new ChatV2SessionHistoryService(store, () => "pal-1", globalIdentity: false);
+                history.StartNewSession("original");
+                history.Append(new ChatV2Message(ChatV2MessageId.Create("first"), ChatV2MessageRole.User, "First"));
+                // The sync worker saved this update after the current transcript was loaded.
+                store.SaveMessage("pal-1", "original", new ChatV2Message(ChatV2MessageId.Create("new"), ChatV2MessageRole.Assistant, "New reply"));
+                var attachments = new ChatV2AttachmentStateService();
+                attachments.SetPending(ChatV2AttachmentKind.Image, "data:image/png;base64,AQID");
+                var messages = new ChatV2MessageStore();
+                int refreshes = 0;
+                var coordinator = new ChatV2HistoryCoordinator(history, messages, attachments, new ChatV2StatusService(),
+                    () => null, _ => { }, () => { }, () => { }, () => refreshes++);
+                external = new ChatV2ExternalConversationService(store, root,
+                    local: new ChatV2LocalConversationSync(root, new Dictionary<string, string>()));
+                var flags = BindingFlags.Instance | BindingFlags.NonPublic;
+                var type = typeof(ChatV2RuntimeHostController);
+                type.GetField("_history", flags).SetValue(host, history);
+                type.GetField("_attachments", flags).SetValue(host, attachments);
+                type.GetField("_historyCoordinator", flags).SetValue(host, coordinator);
+                type.GetField("_externalConversations", flags).SetValue(host, external);
+                var pending = type.GetField("_pendingExternalConversationRefresh", flags);
+                pending.SetValue(host, "original");
+                var tick = type.GetMethod("TickExternalConversations", flags);
+
+                tick.Invoke(host, null);
+                Assert.That(refreshes, Is.Zero);
+                Assert.That(pending.GetValue(host), Is.EqualTo("original"));
+                if (changeSelection) history.StartNewSession("other");
+                attachments.Clear();
+                // No new source update is queued in this tick.
+                tick.Invoke(host, null);
+
+                Assert.That(refreshes, Is.EqualTo(changeSelection ? 0 : 1));
+                Assert.That(pending.GetValue(host), Is.Null);
+                Assert.That(messages.Messages.Count, Is.EqualTo(changeSelection ? 0 : 2));
+                Assert.That(history.Current.SessionId, Is.EqualTo(changeSelection ? "other" : "original"));
+            }
+            finally
+            {
+                Object.DestroyImmediate(gameObject);
+                external?.Dispose();
+                if (Directory.Exists(root)) Directory.Delete(root, true);
+            }
+        }
