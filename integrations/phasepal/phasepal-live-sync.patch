+                !paths.TryResolveDirectChildFile(settings, "external_conversations.json", out _statePath))
+                throw new IOException("External conversation settings path is unavailable.");
+        }
+
+        private void Load()
+        {
+            if (_loaded) return;
+            Dictionary<string, Record> loaded = new Dictionary<string, Record>(StringComparer.Ordinal);
+            if (File.Exists(_statePath))
+            {
+                var root = JObject.Parse(File.ReadAllText(_statePath));
+                if ((int?)root["schema"] != 2) throw new InvalidDataException("Unsupported external conversation state.");
+                loaded = root["records"]?.ToObject<Dictionary<string, Record>>() ??
+                    throw new InvalidDataException("External conversation state needs recovery.");
+            }
+            lock (_recordsGate)
+            {
+                if (_loaded) return;
+                _records = loaded;
+                _loaded = true;
+            }
+        }
+
+        private void Save()
+        {
+            Dictionary<string, Record> snapshot;
+            lock (_recordsGate) snapshot = new Dictionary<string, Record>(_records, StringComparer.Ordinal);
+            string json = JsonConvert.SerializeObject(new { schema = 2, records = snapshot });
+            Directory.CreateDirectory(Path.GetDirectoryName(_statePath));
+            string temporary = _statePath + ".tmp";
+            File.WriteAllText(temporary, json);
+            if (File.Exists(_statePath)) File.Replace(temporary, _statePath, _statePath + ".bak");
+            else File.Move(temporary, _statePath);
+        }
+
+        private void PersistRecord(string sessionId, Record record)
+        {
+            Record previous;
+            lock (_recordsGate) { _records.TryGetValue(sessionId, out previous); _records[sessionId] = record; }
+            try { Save(); }
+            catch {
+                lock (_recordsGate) {
+                    if (previous == null) _records.Remove(sessionId);
+                    else _records[sessionId] = previous;
+                }
+                throw;
+            }
+        }
+
+        /// <summary>Loads ownership records on a history worker.</summary>
+        public void Initialize() => Load();
+
+        /// <summary>Reads cached ownership without disk access.</summary>
+        public ChatV2ExternalConversationInfo GetInfo(string sessionId)
+        {
+            lock (_recordsGate)
+            {
+                if (!_records.TryGetValue(sessionId ?? string.Empty, out Record record) || record.Deleted) return null;
+                return new ChatV2ExternalConversationInfo { SessionId = record.SessionId,
+                    CharacterId = record.AssignedCharacterId,
+                    OriginalSessionId = record.OriginalSessionId,
+                    Source = record.Source, SourceName = SourceName(record.Source),
+                    SourceUrl = record.Source == "chatgpt" ? "https://chatgpt.com/c/" + record.ExternalId
+                        : record.Source == "claude" ? "https://claude.ai/chat/" + record.ExternalId : null };
+            }
+        }
+
+        /// <summary>Protects browser-owned transcripts, including before registry initialization.</summary>
+        public bool CanWrite(string sessionId)
+        {
+            sessionId = sessionId?.Trim() ?? string.Empty;
+            if (!_loaded && (sessionId ?? string.Empty).StartsWith("ocl-", StringComparison.Ordinal)) return false;
+            ChatV2ExternalConversationInfo info = GetInfo(sessionId);
+            return info == null ? !(sessionId ?? string.Empty).StartsWith("ocl-", StringComparison.Ordinal) : info.IsLocalCopy;
+        }
+
+        /// <summary>Computes the stable local identity hash.</summary>
+        public static string Hash(string value)
+        {
+            using (SHA256 algorithm = SHA256.Create())
+                return BitConverter.ToString(algorithm.ComputeHash(Encoding.UTF8.GetBytes(value))).Replace("-", "").ToLowerInvariant();
+        }
+
+        /// <summary>Returns the display name of a supported source.</summary>
+        public static string SourceName(string source) => source == "chatgpt" ? "ChatGPT"
+            : source == "claude" ? "Claude" : source == "codex" ? "Codex" : "Claude Code";
+
+        /// <summary>Identifies transcript changes that must not be overwritten by sync.</summary>
+        public static string Fingerprint(IReadOnlyList<ChatV2Message> messages)
+            => Hash(JsonConvert.SerializeObject(messages.Select(m => new {
+                id = m.Id.Value, role = (int)m.Role, m.Text, m.RawText, m.Reaction,
+                createdAt = m.CreatedAt.ToUnixTimeMilliseconds(),
+                attachment = (int)m.AttachmentKind, m.AttachmentUrl
+            })));
+
+        /// <summary>Validates ordered text messages and maps them to ChatV2 history records.</summary>
+        public static IReadOnlyList<ChatV2Message> ParseMessages(JObject conversation, string sessionId,
+            string characterId, string characterName)
+        {
+            var source = conversation["messages"] as JArray;
+            if (source == null || source.Count > 20000) throw new InvalidDataException("Invalid conversation messages.");
+            var result = new List<ChatV2Message>();
+            for (int i = 0; i < source.Count; i++)
+            {
+                JObject row = source[i] as JObject ?? throw new InvalidDataException("Invalid message.");
+                if (row["index"]?.Type != JTokenType.Integer || (int)row["index"] != i ||
+                    row["text"]?.Type != JTokenType.String || row["createdAt"]?.Type != JTokenType.Integer)
+                    throw new InvalidDataException("Invalid message fields.");
+                string role = (string)row["role"];
+                if (role != "user" && role != "assistant") throw new InvalidDataException("Unsupported message role.");
+                string text = (string)row["text"];
+                if (string.IsNullOrWhiteSpace(text)) continue;
+                DateTimeOffset createdAt = DateTimeOffset.FromUnixTimeMilliseconds((long)row["createdAt"]);
+                result.Add(new ChatV2Message(ChatV2MessageId.Create(sessionId + ":legacy-" + i),
+                    role == "user" ? ChatV2MessageRole.User : ChatV2MessageRole.Assistant, text, text,
+                    createdAt: createdAt, metadata: new Dictionary<string, string> {
+                        ["openchatlink.session"] = sessionId,
+                        [ChatV2CharacterMetadata.TURN_CHARACTER_ID] = characterId,
+                        [ChatV2CharacterMetadata.TURN_CHARACTER_NAME] = characterName ?? string.Empty
+                    }));
+            }
+            return result;
+        }
+
+        /// <summary>Imports an idempotent source snapshot unless it was deleted or changed locally.</summary>
+        public async Task<(string SessionId, bool Conflict, bool Accepted, bool Changed)> ImportAsync(
