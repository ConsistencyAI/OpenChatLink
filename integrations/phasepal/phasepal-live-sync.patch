+                History = history, MessagingSessionRoutes = routes, Status = status, PlayClickSound = () => { }
+            });
+
+            string handler = channel == "telegram" ? "OnHistorySessionTelegramRouteRequested" : "OnHistorySessionDiscordRouteRequested";
+            typeof(ChatV2ShellEventHandlerFactory).GetMethod(handler, BindingFlags.Instance | BindingFlags.NonPublic)
+                .Invoke(factory, new object[] { " original " });
+
+            Assert.That(routes.Calls, Is.Zero);
+            Assert.That(status.Current.Severity, Is.EqualTo(ChatV2StatusSeverity.Warning));
+            Assert.That(status.Current.Source, Is.EqualTo("external-conversation"));
+        }
+
+        private sealed class RecordingRoutes : ILocalMessagingSessionRouteService
+        {
+            public int Calls;
+            public bool TryRouteTelegramToSession(string characterId, string sessionId, IReadOnlyList<ChatV2Message> messages, out string status)
+            { Calls++; status = "routed"; return true; }
+            public bool TryRouteDiscordToSession(string characterId, string sessionId, IReadOnlyList<ChatV2Message> messages, out string status)
+            { Calls++; status = "routed"; return true; }
+            public string GetTelegramTargetSessionId(string characterId) => null;
+            public string GetDiscordTargetSessionId(string characterId) => null;
+            public void ClearTelegramRouteToSession(string characterId, string sessionId) { }
+            public void ClearDiscordRouteToSession(string characterId, string sessionId) { }
+        }
