+// #Assets/_PhasePal/Tests/Services/ChatV2/EditMode/ChatV2ExternalConversationTests.cs
+using System;
+using System.IO;
+using System.Linq;
+using System.Net.Http;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json.Linq;
+using NUnit.Framework;
+using PhasePal.Services.ChatV2.Core;
+using PhasePal.Services.ChatV2.Platform;
+
+namespace PhasePal.Tests.ChatV2.EditMode
+{
+    public sealed class ChatV2ExternalConversationTests
+    {
+        private string _root;
+        private IChatV2HistoryStore _history;
+        private ChatV2ExternalConversationStore _store;
+
+        [SetUp]
+        public void SetUp()
+        {
+            _root = Path.Combine(Path.GetTempPath(), "OpenChatLinkTests_" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(_root);
+            _history = new ChatV2FileHistoryStore(Path.Combine(_root, "ChatV2History"), string.Empty);
+            _store = new ChatV2ExternalConversationStore(_history, _root);
+        }
+        [TearDown]
+        public void TearDown()
+        {
+            string resolved = Path.GetFullPath(_root);
+            string parent = Path.GetFullPath(Path.GetTempPath());
+            if (!resolved.StartsWith(parent, StringComparison.OrdinalIgnoreCase) ||
+                !Path.GetFileName(resolved).StartsWith("OpenChatLinkTests_", StringComparison.Ordinal))
+                throw new InvalidOperationException("Unexpected test directory.");
+            if (Directory.Exists(resolved)) Directory.Delete(resolved, true);
+        }
+        private static JObject Conversation(string reply = "こんにちは")
+            => new JObject {
+                ["id"] = "00000000-0000-4000-8000-000000000001", ["accountId"] = "personal",
+                ["title"] = "Reina", ["updatedAt"] = 1720000100123L,
+                ["messages"] = new JArray(
+                    new JObject { ["index"] = 0, ["role"] = "user", ["text"] = "Hello | 🌸", ["createdAt"] = 1720000000123L },
+                    new JObject { ["index"] = 1, ["role"] = "assistant", ["text"] = reply, ["createdAt"] = 1720000001456L })
+            };
+
+        [TestCase(false)]
+        [TestCase(true)]
+        public async Task ImportsActualHistoryAndIdempotentRetry(bool global)
+        {
+            if (global)
+            {
+                _history = new ChatV2GlobalHistoryStore(Path.Combine(_root, "ChatV2History"));
+                _store = new ChatV2ExternalConversationStore(_history, _root);
+            }
+            var result = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            var rows = _history.LoadPage("avatar", result.SessionId, 10);
+            Assert.That(rows.Select(row => row.Text), Is.EqualTo(new[] { "Hello | 🌸", "こんにちは" }));
+            Assert.That(rows[0].CreatedAt.ToUnixTimeMilliseconds(), Is.EqualTo(1720000000123L));
+            Assert.That(_store.CanWrite(result.SessionId), Is.False);
+            var retry = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            Assert.That(retry.SessionId, Is.EqualTo(result.SessionId));
+            Assert.That(retry.Changed, Is.False);
+            Assert.That(_history.LoadPage("avatar", result.SessionId, 10).Count, Is.EqualTo(2));
+            JObject corrected = Conversation();
+            corrected["messages"][0]["createdAt"] = 1720000000999L;
+            Assert.That((await _store.ImportAsync(corrected, "avatar", "Reina", CancellationToken.None)).Changed, Is.True);
+            Assert.That(_history.LoadPage("avatar", result.SessionId, 10)[0].CreatedAt.ToUnixTimeMilliseconds(), Is.EqualTo(1720000000999L));
+        }
+
+        [Test]
+        public async Task LocalCopyRetainsConversationAndOriginalKeepsSyncing()
+        {
+            var original = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            string copy = await _store.CreateLocalCopyAsync(original.SessionId, "avatar", CancellationToken.None);
+            _history.SaveMessage("avatar", copy, new ChatV2Message(ChatV2MessageId.Create(null), ChatV2MessageRole.User, "Local reply"));
+            await _store.ImportAsync(Conversation("Updated in ChatGPT"), "avatar", "Reina", CancellationToken.None);
+            Assert.That(_history.LoadPage("avatar", original.SessionId, 10).Last().Text, Is.EqualTo("Updated in ChatGPT"));
+            Assert.That(_history.LoadPage("avatar", copy, 10).Select(m => m.Text),
+                Is.EqualTo(new[] { "Hello | 🌸", "こんにちは", "Local reply" }));
+            Assert.That(_store.GetInfo(copy).OriginalSessionId, Is.EqualTo(original.SessionId));
+            Assert.That(_store.CanWrite(copy), Is.True);
+        }
+
+        [Test]
+        public async Task LocalModificationIsNeverOverwritten()
+        {
+            var original = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            _history.SaveMessage("avatar", original.SessionId,
+                new ChatV2Message(ChatV2MessageId.Create(null), ChatV2MessageRole.User, "Local change"));
+            var result = await _store.ImportAsync(Conversation("Updated"), "avatar", "Reina", CancellationToken.None);
+            Assert.That(result.Conflict, Is.True);
+            Assert.That(_history.LoadPage("avatar", original.SessionId, 10).Last().Text, Is.EqualTo("Local change"));
+        }
+
+        [Test]
+        public async Task DeletedSyncedChatsStayDeletedAfterRestart()
+        {
+            var original = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            _history.DeleteSession("avatar", original.SessionId);
+            _store = new ChatV2ExternalConversationStore(_history, _root);
+            var result = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            Assert.That(result.Accepted, Is.False);
+            Assert.That(_history.GetSessionSummary("avatar", original.SessionId), Is.Null);
+        }
+
+        [Test]
+        public async Task CoreWritePolicyProtectsSyncedOriginalAcrossAppendAndEdits()
+        {
+            var original = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            var visible = new ChatV2SessionHistoryService(_history, () => "avatar");
+            visible.CanWriteSession = _store.CanWrite;
+            visible.LoadSession(original.SessionId, 10);
+            var first = visible.GetCurrentSessionMessages()[0];
+            visible.Append(new ChatV2Message(ChatV2MessageId.Create(null), ChatV2MessageRole.User, "blocked"));
+            Assert.That(visible.RemoveMessage(first.Id), Is.False);
+            Assert.That(visible.TruncateFrom(first.Id), Is.False);
+            Assert.That(visible.SetMessageReaction(first.Id, "heart"), Is.False);
+            Assert.That(visible.ReplaceSessionMessages("avatar", " " + original.SessionId + " ", "Overwrite",
+                new[] { new ChatV2Message(ChatV2MessageId.Create(null), ChatV2MessageRole.User, "blocked") }), Is.False);
+            Assert.That(_history.LoadPage("avatar", original.SessionId, 10).Count, Is.EqualTo(2));
+        }
+
+        [TestCase("system")]
+        [TestCase("tool")]
+        public async Task RejectsUnsupportedRolesBeforeWriting(string role)
+        {
+            JObject payload = Conversation();
+            payload["messages"][0]["role"] = role;
+            bool rejected = false;
+            try { await _store.ImportAsync(payload, "avatar", "Reina", CancellationToken.None); }
+            catch (InvalidDataException) { rejected = true; }
+            Assert.That(rejected, Is.True);
+            Assert.That(_history.ListSessions("avatar", 10), Is.Empty);
+        }
+
+        [Test]
+        public async Task PreCanceledImportDoesNotWrite()
+        {
+            using (var cancellation = new CancellationTokenSource())
+            {
+                cancellation.Cancel();
+                bool canceled = false;
+                try { await _store.ImportAsync(Conversation(), "avatar", "Reina", cancellation.Token); }
+                catch (OperationCanceledException) { canceled = true; }
+                Assert.That(canceled, Is.True);
+                Assert.That(_history.ListSessions("avatar", 10), Is.Empty);
+            }
