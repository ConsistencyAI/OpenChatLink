+// #Assets/_PhasePal/Scripts/Services/ChatV2/Platform/ChatV2LocalConversationSync.cs
+using System;
+using System.Collections.Generic;
+using System.Collections.Concurrent;
+using System.Diagnostics;
+using System.Globalization;
+using System.IO;
+using System.Linq;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using PhasePal.Security;
+
+namespace PhasePal.Services.ChatV2.Platform
+{
+    /// <summary>Reads opted-in local JSONL histories on workers. Never modifies a source file.</summary>
+    public sealed class ChatV2LocalConversationSync
+    {
+        private readonly Dictionary<string, string> _roots;
+        private readonly string _settingsPath;
+        private readonly SemaphoreSlim _writer = new SemaphoreSlim(1, 1);
+        private readonly Dictionary<string, string> _completed = new Dictionary<string, string>();
+        private readonly ConcurrentDictionary<string, SourceFile> _headers = new ConcurrentDictionary<string, SourceFile>();
+        private JObject _profiles = new JObject();
+        private JObject _accounts = new JObject();
+        private HashSet<string> _pending = new HashSet<string>();
+        private bool _loaded;
+        private int _revision;
+        private const long MAX_FILE_BYTES = 64L * 1024 * 1024;
+
+        private sealed class SourceFile
+        {
+            public string Path, Id, Title;
+            public long Modified, Length, Created;
+        }
+
+        public ChatV2LocalConversationSync(string persistentDataPath, Dictionary<string, string> roots = null)
+        {
+            string home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
+            _roots = roots ?? new Dictionary<string, string> {
+                ["codex"] = Environment.GetEnvironmentVariable("CODEX_HOME") ?? Path.Combine(home, ".codex"),
+                ["claude-code"] = Path.Combine(Environment.GetEnvironmentVariable("CLAUDE_CONFIG_DIR") ?? Path.Combine(home, ".claude"), "projects")
+            };
+            var paths = new PhasePalOwnedPathService(persistentDataPath);
+            if (!paths.TryResolveIdentifierDirectory("Settings", out string settings) ||
+                !paths.TryResolveDirectChildFile(settings, "external_local_conversations.json", out _settingsPath))
+                throw new IOException("Local sync settings are unavailable.");
+        }
+
+        private string Root(string source)
+        {
+            if (source != "codex" && source != "claude-code" || !_roots.TryGetValue(source, out string path))
+                throw new InvalidDataException("Unsupported local source.");
+            return Path.GetFullPath(path);
+        }
+
+        private string Account(string source)
+        {
+            string root = Root(source);
+            if (Path.DirectorySeparatorChar == '\\') root = root.ToUpperInvariant();
+            return "local-" + ChatV2ExternalConversationStore.Hash(root).Substring(0, 24);
+        }
+
+        private void Load()
+        {
+            if (_loaded) return;
+            if (File.Exists(_settingsPath))
+            {
+                JObject saved = JObject.Parse(File.ReadAllText(_settingsPath));
+                if ((int?)saved["schema"] != 1) throw new InvalidDataException("Invalid local sync settings.");
+                _profiles = saved["profiles"] as JObject ?? new JObject();
+                _accounts = saved["accounts"] as JObject ?? throw new InvalidDataException("Invalid local source scopes.");
+                _pending = new HashSet<string>((saved["pending"] as JArray ?? new JArray()).Values<string>());
+                foreach (var profile in _profiles.Properties())
+                    if (_roots.ContainsKey(profile.Name) && (string)_accounts[profile.Name] == Account(profile.Name)) Validate(profile.Name, (JObject)profile.Value);
+            }
+            _loaded = true;
+        }
+
+        private void Save()
+        {
+            Directory.CreateDirectory(Path.GetDirectoryName(_settingsPath));
+            File.WriteAllText(_settingsPath + ".tmp", new JObject {
+                ["schema"] = 1, ["profiles"] = _profiles.DeepClone(), ["accounts"] = _accounts.DeepClone(), ["pending"] = new JArray(_pending.OrderBy(x => x))
+            }.ToString(Formatting.None));
+            if (File.Exists(_settingsPath)) File.Replace(_settingsPath + ".tmp", _settingsPath, null);
+            else File.Move(_settingsPath + ".tmp", _settingsPath);
+        }
+
+        private void Validate(string source, JObject profile)
+        {
+            Root(source);
+            if (profile.Properties().Any(property => !new[] { "chats", "selected", "history", "sinceDate", "schedule" }.Contains(property.Name)))
+                throw new InvalidDataException("Unsupported local sync setting.");
+            string chats = (string)profile["chats"], history = (string)profile["history"], schedule = (string)profile["schedule"];
+            if ((chats != "all" && chats != "selected") || (history != "all" && history != "last100" && history != "since") ||
+                (schedule != "auto" && schedule != "manual")) throw new InvalidDataException("Invalid local sync choices.");
+            if (history == "since" && !DateTimeOffset.TryParseExact((string)profile["sinceDate"], "yyyy-MM-dd",
+                CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out _)) throw new InvalidDataException("Invalid date.");
+            JArray selected = profile["selected"] as JArray ?? throw new InvalidDataException("Missing chat selection.");
+            if (selected.Count > 5000) throw new InvalidDataException("Too many selected chats.");
+            foreach (JObject row in selected)
+                if (row.Properties().Any(property => property.Name != "accountId" && property.Name != "id" && property.Name != "title") ||
+                    ((string)row["title"])?.Length > 300 || (string)row["accountId"] != Account(source) || !Guid.TryParse((string)row["id"], out _))
+                    throw new InvalidDataException("Select chats from this local source.");
+        }
+
+        /// <summary>Saves selections without accepting paths or credentials from the client.</summary>
+        public async Task ConfigureAsync(string source, JObject profile, CancellationToken token)
+        {
+            Validate(source, profile);
+            Interlocked.Increment(ref _revision);
+            await _writer.WaitAsync(token).ConfigureAwait(false);
+            try { Load(); _profiles[source] = profile.DeepClone(); _accounts[source] = Account(source); _pending.Remove(source); Save(); }
+            finally { _writer.Release(); }
+        }
+
+        /// <summary>Queues one manual import, including bounded continuation passes.</summary>
+        public async Task RequestSyncAsync(string source, CancellationToken token)
+        {
+            Root(source);
+            await _writer.WaitAsync(token).ConfigureAwait(false);
+            try {
+                Load();
+                JObject profile = _profiles[source] as JObject;
+                if (profile == null || (string)_accounts[source] != Account(source) || ((string)profile["chats"] == "selected" && ((JArray)profile["selected"]).Count == 0))
+                    throw new InvalidDataException("Choose chats before syncing.");
+                foreach (string key in _completed.Keys.Where(key => key.StartsWith(source + ":", StringComparison.Ordinal)).ToArray()) _completed.Remove(key);
+                _pending.Add(source); Save();
+            }
+            finally { _writer.Release(); }
+        }
+
+        /// <summary>Stops collection while keeping saved user choices.</summary>
+        public async Task PauseAsync(CancellationToken token)
+        {
+            Interlocked.Increment(ref _revision);
+            await _writer.WaitAsync(token).ConfigureAwait(false);
+            try {
+                Load();
+                foreach (JProperty profile in _profiles.Properties()) ((JObject)profile.Value)["schedule"] = "manual";
+                _pending.Clear(); Save();
+            }
+            finally { _writer.Release(); }
+        }
+
+        /// <summary>Returns a bounded page of titles from local files, without exposing paths.</summary>
+        public object Catalog(string source, int offset, CancellationToken token)
+        {
+            if (offset < 0 || offset > 10000) throw new InvalidDataException("Invalid catalog page.");
+            var files = Scan(source, token, out int failures);
+            var items = files.Skip(offset).Take(50).Select(file => new {
+                accountId = Account(source), id = file.Id, title = file.Title, updatedAt = file.Modified
+            }).ToArray();
+            return new { protocol = ChatV2ExternalConversationReceiver.PROTOCOL, items,
+                nextCursor = offset + items.Length < files.Count ? (int?)(offset + items.Length) : null,
+                failures, available = Directory.Exists(Root(source)) };
+        }
+
+        private static bool IsLinked(string path)
+        {
+            for (string current = Path.GetFullPath(path); !string.IsNullOrEmpty(current); current = Path.GetDirectoryName(current))
+                if (File.Exists(current) || Directory.Exists(current))
+                    if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0) return true;
+            return false;
+        }
+
+        private List<SourceFile> Scan(string source, CancellationToken token, out int failures)
+        {
+            string root = Root(source);
+            failures = 0;
+            var files = new Dictionary<string, SourceFile>();
+            if (!Directory.Exists(root) || IsLinked(root)) return files.Values.ToList();
+            var directories = new Queue<(string Path, int Depth)>();
+            if (source == "codex") {
+                directories.Enqueue((Path.Combine(root, "sessions"), 0));
+                directories.Enqueue((Path.Combine(root, "archived_sessions"), 0));
+            } else directories.Enqueue((root, 0));
+            int scanned = 0, visited = 0;
+            while (directories.Count > 0)
+            {
+                token.ThrowIfCancellationRequested();
+                var directory = directories.Dequeue();
+                if (++visited > 10000) { failures++; break; }
+                if (!Directory.Exists(directory.Path) || IsLinked(directory.Path)) continue;
+                try {
+                    if (directory.Depth < 12)
+                        foreach (string child in Directory.EnumerateDirectories(directory.Path))
+                        {
+                            if (directories.Count + visited >= 10000) { failures++; break; }
+                            if (Path.GetFileName(child) != "subagents") directories.Enqueue((child, directory.Depth + 1));
+                        }
+                    foreach (string path in Directory.EnumerateFiles(directory.Path, "*.jsonl"))
+                    {
+                        token.ThrowIfCancellationRequested();
+                        if (++scanned > 10000) { failures++; return files.Values.OrderByDescending(x => x.Modified).ToList(); }
+                        try {
+                            if (IsLinked(path)) continue;
+                            var info = new FileInfo(path);
+                            if (info.Length > MAX_FILE_BYTES) { failures++; continue; }
+                            if (!_headers.TryGetValue(path, out SourceFile cached) || cached.Created != info.CreationTimeUtc.Ticks) {
+                                JObject header = Read(source, path, true, token);
+                                if (!Guid.TryParse((string)header?["id"], out Guid parsed)) continue;
+                                cached = new SourceFile { Id = parsed.ToString("D"), Title = (string)header["title"], Created = info.CreationTimeUtc.Ticks };
+                                _headers[path] = cached;
+                            }
+                            var file = new SourceFile { Path = path, Id = cached.Id, Title = cached.Title,
+                                Modified = new DateTimeOffset(info.LastWriteTimeUtc).ToUnixTimeMilliseconds(), Length = info.Length };
+                            if (!files.TryGetValue(file.Id, out SourceFile old) || old.Modified < file.Modified) files[file.Id] = file;
+                        } catch (IOException) { failures++; } catch (JsonException) { failures++; }
+                    }
+                } catch (UnauthorizedAccessException) { failures++; } catch (IOException) { failures++; }
+            }
+            return files.Values.OrderByDescending(x => x.Modified).ThenBy(x => x.Id, StringComparer.Ordinal).ToList();
+        }
+
+        private static long Timestamp(JToken value)
+        {
+            if (value?.Type == JTokenType.Integer || value?.Type == JTokenType.Float) {
+                double number = (double)value;
+                return checked((long)(number < 1e12 ? number * 1000 : number));
+            }
+            return DateTimeOffset.TryParse((string)value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal, out var time)
+                ? time.ToUnixTimeMilliseconds() : 0;
+        }
+
+        private static string VisibleText(JToken content)
+        {
+            if (content?.Type == JTokenType.String) return (string)content;
+            return content is JArray blocks ? string.Join("\n", blocks.OfType<JObject>()
+                .Where(block => (string)block["type"] == "text" || (string)block["type"] == "input_text" || (string)block["type"] == "output_text")
+                .Select(block => (string)block["text"]).Where(text => !string.IsNullOrWhiteSpace(text))) : string.Empty;
+        }
+
+        private static bool IsContext(string text) => text.StartsWith("# AGENTS.md instructions", StringComparison.Ordinal)
+            || text.StartsWith("<environment_context>", StringComparison.Ordinal) || text.StartsWith("<permissions instructions>", StringComparison.Ordinal);
+
+        private static JObject Read(string source, string path, bool headerOnly, CancellationToken token)
+        {
+            string id = source == "claude-code" ? Path.GetFileNameWithoutExtension(path) : null;
+            string title = null;
+            var messages = new List<JObject>();
+            var positions = new Dictionary<string, int>();
+            using (var stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete))
+            using (var reader = new StreamReader(stream, Encoding.UTF8, true))
+            {
+                if (stream.Length > MAX_FILE_BYTES) throw new IOException("Local conversation exceeds the size limit.");
+                int lines = 0, characters = 0;
+                string line;
+                while ((line = reader.ReadLine()) != null)
+                {
+                    token.ThrowIfCancellationRequested();
+                    if (++lines > 200000 || line.Length > 1024 * 1024) throw new IOException("Local conversation exceeds the record limit.");
+                    characters += line.Length;
+                    if (headerOnly && (lines > 200 || characters > 256 * 1024)) break;
+                    JObject row;
+                    try { row = JObject.Parse(line); }
+                    catch (JsonException) { if (reader.EndOfStream) break; throw; }
+                    JObject message;
+                    string role, key = null;
+                    if (source == "codex") {
+                        if ((string)row["type"] == "session_meta") { id = (string)(row["payload"]?["meta"] ?? row["payload"])?["id"]; continue; }
+                        if ((string)row["type"] != "response_item") continue;
+                        message = row["payload"] as JObject;
+                        if ((string)message?["type"] != "message" || (string)message["channel"] == "analysis" ||
+                            (!string.IsNullOrEmpty((string)message["recipient"]) && (string)message["recipient"] != "all")) continue;
+                        role = (string)message["role"];
+                    } else {
+                        if ((bool?)row["isSidechain"] == true || (bool?)row["isMeta"] == true || (bool?)row["isCompactSummary"] == true ||
+                            (bool?)row["isVisibleInTranscriptOnly"] == true) continue;
+                        if (!string.IsNullOrEmpty((string)row["sessionId"])) id = (string)row["sessionId"];
+                        message = row["message"] as JObject;
+                        role = (string)message?["role"]; key = (string)row["uuid"];
+                    }
+                    if (role != "user" && role != "assistant") continue;
+                    string text = VisibleText(message["content"]);
+                    if (string.IsNullOrWhiteSpace(text) || (role == "user" && IsContext(text))) continue;
+                    if (role == "user" && title == null) title = text.Substring(0, Math.Min(150, text.Length));
+                    if (headerOnly) { if (title != null && id != null) break; continue; }
+                    var parsed = new JObject { ["role"] = role, ["text"] = text, ["createdAt"] = Timestamp(row["timestamp"]) };
+                    if (key != null && positions.TryGetValue(key, out int position)) messages[position] = parsed;
+                    else { if (key != null) positions[key] = messages.Count; messages.Add(parsed); }
+                    if (messages.Count > 20000) throw new IOException("Too many visible local messages.");
+                }
+            }
+            if (Guid.TryParse(id, out Guid normalized)) id = normalized.ToString("D");
+            return new JObject { ["id"] = id, ["title"] = title ?? ChatV2ExternalConversationStore.SourceName(source) + " conversation", ["messages"] = new JArray(messages) };
+        }
+
+        /// <summary>Runs one bounded pass for automatic or explicitly queued sources.</summary>
+        public async Task<int> RunAsync(Func<JObject, CancellationToken, Task<bool>> import, CancellationToken token)
+        {
+            await _writer.WaitAsync(token).ConfigureAwait(false);
+            try {
+                Load(); int revision = _revision, totalFailures = 0;
+                foreach (string source in new[] { "codex", "claude-code" })
+                {
+                    JObject profile = _profiles[source] as JObject;
+                    if (profile == null || (string)_accounts[source] != Account(source) || ((string)profile["schedule"] != "auto" && !_pending.Contains(source))) continue;
+                    var selected = new HashSet<string>((profile["selected"] as JArray).OfType<JObject>().Select(row => ((string)row["id"]).ToLowerInvariant()));
+                    if ((string)profile["chats"] != "all" && selected.Count == 0) continue;
+                    var watch = Stopwatch.StartNew(); int processed = 0;
+                    bool more = false;
+                    var files = Scan(source, token, out int failures);
+                    foreach (SourceFile file in files)
+                    {
+                        token.ThrowIfCancellationRequested();
+                        if (revision != _revision) return totalFailures;
+                        if ((string)profile["chats"] != "all" && !selected.Contains(file.Id)) continue;
+                        string key = source + ":" + file.Id;
+                        string stamp = file.Modified + ":" + file.Length + ":" + profile.ToString(Formatting.None);
+                        if (_completed.TryGetValue(key, out string done) && done == stamp) continue;
+                        if (processed >= 50 || watch.Elapsed.TotalSeconds >= 20) { more = true; break; }
+                        try {
+                            if (IsLinked(file.Path)) continue;
+                            JObject conversation = Read(source, file.Path, false, token);
+                            if ((string)conversation["id"] != file.Id) throw new IOException("Local conversation identity changed.");
+                            IEnumerable<JObject> rows = ((JArray)conversation["messages"]).OfType<JObject>();
+                            if ((string)profile["history"] == "last100") rows = rows.Skip(Math.Max(0, ((JArray)conversation["messages"]).Count - 100));
+                            if ((string)profile["history"] == "since") {
+                                long cutoff = DateTimeOffset.ParseExact((string)profile["sinceDate"], "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.AssumeUniversal).ToUnixTimeMilliseconds();
+                                rows = rows.Where(row => (long)row["createdAt"] >= cutoff);
+                            }
+                            conversation["messages"] = new JArray(rows.Select((row, index) => { row["index"] = index; return row; }));
+                            conversation["source"] = source; conversation["accountId"] = Account(source); conversation["updatedAt"] = file.Modified;
+                            if (revision != _revision) return totalFailures;
+                            if (await import(conversation, token).ConfigureAwait(false)) _completed[key] = stamp;
+                            else failures++;
+                            processed++;
+                        } catch (IOException) { failures++; } catch (JsonException) { failures++; }
+                    }
+                    if (!more && _pending.Remove(source)) Save();
+                    totalFailures += failures;
+                }
+                return totalFailures;
+            }
+            finally { _writer.Release(); }
+        }
+    }
+}
