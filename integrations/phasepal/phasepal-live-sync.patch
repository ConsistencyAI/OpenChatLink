+        private static async Task WaitUntil(Func<bool> condition)
+        {
+            DateTime deadline = DateTime.UtcNow.AddSeconds(8);
+            while (!condition()) {
+                if (DateTime.UtcNow >= deadline) Assert.Fail("Local sync did not complete.");
+                await Task.Delay(25);
+            }
+        }
+
+        [Test]
+        public async Task MissingHistoryConsentOrSecureStorageCannotStartReceiver()
+        {
+            var secrets = new Secrets { IsAvailable = false };
+            using (var service = new ChatV2ExternalConversationService(_history, _root, secrets))
+            {
+                await service.ResumeAsync(false);
+                await service.SetEnabledAsync(true, "avatar", "Reina");
+                Assert.That(service.Enabled, Is.False);
+                await service.ResumeAsync(true);
+                await service.SetEnabledAsync(true, "avatar", "Reina");
+                Assert.That(service.Ready, Is.False);
+                Assert.That(service.GetConnectionCode(), Is.Empty);
+            }
+        }
+
+        [TestCase(false)]
+        [TestCase(true)]
+        public async Task SuspensionOrConsentRevocationRejectsLateCredentialCompletion(bool revokeConsent)
+        {
+            var secrets = new Secrets { Pending = new TaskCompletionSource<ChatV2ExternalMemorySecretLoadResult>(
+                TaskCreationOptions.RunContinuationsAsynchronously) };
+            using (var service = new ChatV2ExternalConversationService(_history, _root, secrets))
+            {
+                await service.ResumeAsync(true);
+                Task enabling = service.SetEnabledAsync(true, "avatar", "Reina");
+                Assert.That(await Task.WhenAny(secrets.LoadStarted.Task, Task.Delay(5000)), Is.SameAs(secrets.LoadStarted.Task));
+                if (revokeConsent) service.Tick(false);
+                else service.Suspend();
+                secrets.Pending.SetResult(new ChatV2ExternalMemorySecretLoadResult(true, secrets.Secret));
+                await enabling;
+                Assert.That(service.Ready, Is.False);
+                Assert.That(service.GetConnectionCode(), Is.Empty);
+            }
+        }
+    }
+}
