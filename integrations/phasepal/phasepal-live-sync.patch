+// #Assets/_PhasePal/Scripts/Services/ChatV2/Platform/ChatV2ExternalConversationService.cs
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.IO;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using PhasePal.Security;
+using PhasePal.Services.ChatV2.Core;
+
+namespace PhasePal.Services.ChatV2.Platform
+{
+    /// <summary>ChatV2 host-owned receiver lifetime. Changes are published by Tick on Unity's thread.</summary>
+    public sealed class ChatV2ExternalConversationService : IChatV2ExternalConversations, IChatV2ExternalSyncFeedback
+    {
+        private readonly ChatV2ExternalConversationStore _store;
+        private readonly ChatV2LocalConversationSync _local;
+        private readonly IChatV2ExternalMemorySecretStore _secrets;
+        private readonly string _settingsPath;
+        private readonly string _scope;
+        private readonly SemaphoreSlim _settingsWriter = new SemaphoreSlim(1, 1);
+        private readonly ConcurrentQueue<string> _changedSessions = new ConcurrentQueue<string>();
+        private readonly CancellationTokenSource _hostLifetime = new CancellationTokenSource();
+        private ChatV2ExternalConversationReceiver _receiver;
+        private CancellationTokenSource _localLifetime;
+        private Task _localWorker;
+        private string _token, _characterId, _characterName;
+        private int _generation, _dirty;
+        private volatile bool _disposed, _historyConsent, _enabled, _suspended;
+        private string _statusText = "External conversation sync is off.";
+        public event Action Changed;
+        public bool Enabled => _enabled;
+        public bool Ready => _receiver != null && _enabled && !_disposed;
+        public string StatusText
+        {
+            get {
+                lock (_syncGate) {
+                    if (_syncRuns.Count == 0) return _statusText;
+                    int updated = 0;
+                    foreach (SyncRun run in _syncRuns.Values) updated += run.Updated;
+                    return "External sync in progress. " + updated + " chats updated. Open Sync activity in OpenChatLink for details.";
+                }
+            }
+        }
+        private readonly object _syncGate = new object();
+        private readonly Dictionary<string, SyncRun> _syncRuns = new Dictionary<string, SyncRun>();
+        private readonly HashSet<string> _failedSources = new HashSet<string>();
+        private readonly Queue<ChatV2ExternalSyncNotice> _syncNotices = new Queue<ChatV2ExternalSyncNotice>();
+        private sealed class SyncRun
+        {
+            public string Id;
+            public bool Manual;
+            public int Updated, Failures;
+            public DateTime Deadline, LastLog;
+        }
+        public bool IsSyncing { get { lock (_syncGate) return _syncRuns.Count > 0; } }
+        /// <summary>Consumes completed feedback on the host thread.</summary>
+        public IReadOnlyList<ChatV2ExternalSyncNotice> TakeSyncNotices()
+        {
+            lock (_syncGate) {
+                var notices = _syncNotices.ToArray(); _syncNotices.Clear(); return notices;
+            }
+        }
+
+        /// <summary>Accepts bounded lifecycle signals from the authenticated browser or local reader.</summary>
+        public void ReportSync(string source, string phase, JObject body, int? owner = null)
+        {
+            if (source != "chatgpt" && source != "claude" && source != "codex" && source != "claude-code") throw new InvalidDataException();
+            if (body == null || body.Count != 3 || body["id"]?.Type != JTokenType.String ||
+                !Guid.TryParse((string)body["id"], out _) || body["manual"]?.Type != JTokenType.Boolean ||
+                body["failures"]?.Type != JTokenType.Integer || (long)body["failures"] < 0 || (long)body["failures"] > 10000 ||
+                (phase != "start" && phase != "progress" && phase != "finish" && phase != "cancel")) throw new InvalidDataException();
+            lock (_syncGate) {
+                if (_disposed || _suspended || !_enabled || !_historyConsent || (owner.HasValue && owner != _generation)) return;
+                string id = (string)body["id"];
+                if (phase == "start" && (!_syncRuns.TryGetValue(source, out SyncRun previous) || previous.Id != id))
+                {
+                    _syncRuns[source] = new SyncRun { Id = id, Manual = (bool)body["manual"], LastLog = DateTime.UtcNow };
+                    if ((bool)body["manual"]) UnityEngine.Debug.Log("[OpenChatLink] " + source + " manual sync started. Browser stages are shown in the extension's Sync activity.");
+                }
+                if (!_syncRuns.TryGetValue(source, out SyncRun run) || run.Id != id) return;
+                if (phase == "start" && (bool)body["manual"]) run.Manual = true;
+                run.Deadline = DateTime.UtcNow.AddMinutes(3);
+                run.Failures = Math.Min(10000, run.Failures + (int)body["failures"]);
+                if (run.Manual && DateTime.UtcNow - run.LastLog >= TimeSpan.FromSeconds(30)) {
+                    run.LastLog = DateTime.UtcNow;
+                    UnityEngine.Debug.Log("[OpenChatLink] " + source + " sync active; " + run.Updated + " chats updated.");
+                }
+                if (phase == "finish" || phase == "cancel") {
+                    _syncRuns.Remove(source);
+                    if (phase == "finish") CompleteSync(source, run);
+                    else if (run.Manual) UnityEngine.Debug.Log("[OpenChatLink] " + source + " manual sync cancelled.");
+                }
+            }
+            MarkChanged();
+        }
+
+        private void CountSyncedChat(string source, int owner)
+        {
+            lock (_syncGate) if (owner == _generation && source != null && _syncRuns.TryGetValue(source, out SyncRun run)) {
+                run.Updated++; run.Deadline = DateTime.UtcNow.AddMinutes(3);
+            }
+        }
+
+        private void CompleteSync(string source, SyncRun run)
+        {
+            string summary = ChatV2ExternalConversationStore.SourceName(source) + " sync " + (run.Failures > 0 ? "could not finish" : "complete") + ". " + run.Updated + " chats updated.";
+            _statusText = summary + (run.Failures > 0 ? " Open Sync activity in OpenChatLink for details, then retry." : string.Empty);
+            bool firstFailure = run.Failures > 0 && _failedSources.Add(source);
+            if (run.Failures == 0) _failedSources.Remove(source);
+            if (run.Manual || firstFailure) {
+                if (run.Failures > 0) UnityEngine.Debug.LogWarning("[OpenChatLink] " + _statusText);
+                else UnityEngine.Debug.Log("[OpenChatLink] " + summary);
+                if (_syncNotices.Count >= 8) _syncNotices.Dequeue();
+                _syncNotices.Enqueue(new ChatV2ExternalSyncNotice { Source = source, Manual = run.Manual,
+                    Updated = run.Updated, Failures = run.Failures });
+            }
+        }
+
+        public ChatV2ExternalConversationService(IChatV2HistoryStore history, string persistentDataPath,
+            IChatV2ExternalMemorySecretStore secrets = null, ChatV2LocalConversationSync local = null)
+        {
+            _store = new ChatV2ExternalConversationStore(history, persistentDataPath);
+            _local = local ?? new ChatV2LocalConversationSync(persistentDataPath);
+            _scope = ChatV2ExternalConversationStore.Hash(Path.GetFullPath(persistentDataPath)).Substring(0, 24);
+            _secrets = secrets ?? new ChatV2ExternalMemoryOsSecretStore(
+                "PhasePal.OpenChatLink." + _scope, "OpenChatLink");
+            var paths = new PhasePalOwnedPathService(persistentDataPath);
+            if (!paths.TryResolveIdentifierDirectory("Settings", out string settings) ||
+                !paths.TryResolveDirectChildFile(settings, "external_conversation_settings.json", out _settingsPath))
+                throw new IOException("External conversation settings path is unavailable.");
+        }
+
+        /// <summary>Loads scoped preferences and resumes sync while chat-history consent allows it.</summary>
+        public async Task ResumeAsync(bool historyConsent)
+        {
+            if (_disposed) return;
+            int generation = Interlocked.Increment(ref _generation);
+            _suspended = false;
+            StopReceiver();
+            _historyConsent = historyConsent;
+            try
+            {
+                JObject saved = await Task.Run(() => {
+                    _store.Initialize();
+                    return File.Exists(_settingsPath) ? JObject.Parse(File.ReadAllText(_settingsPath)) : null;
+                });
+                if (_disposed || _suspended || generation != _generation) return;
+                if (saved != null && (int?)saved["schema"] != 1) throw new InvalidDataException();
+                bool enabled = (bool?)saved?["enabled"] ?? false;
+                _enabled = enabled;
+                _characterId = (string)saved?["characterId"];
+                _characterName = (string)saved?["characterName"];
+                if (enabled && !historyConsent)
+                { _enabled = true; SetStatus("External sync is paused because Store Chat History is off."); }
+                else if (enabled) await SetEnabledAsync(true, _characterId, _characterName);
+                else MarkChanged();
+            }
+            catch (Exception) { if (IsCurrent(generation)) SetStatus("External sync could not start. Check local settings and try again."); }
+        }
+
+        /// <inheritdoc />
+        public async Task SetEnabledAsync(bool enabled, string characterId, string characterName)
+        {
