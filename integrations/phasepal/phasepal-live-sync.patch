+        private string WriteLocalLog(string source, string id, int count = 2)
+        {
+            string root = Path.Combine(_root, source);
+            string folder = source == "codex" ? Path.Combine(root, "sessions", "2026") : Path.Combine(root, "project");
+            Directory.CreateDirectory(folder);
+            string path = Path.Combine(folder, id + ".jsonl");
+            var rows = new List<JObject>();
+            if (source == "codex") rows.Add(new JObject { ["type"] = "session_meta", ["payload"] = new JObject { ["id"] = id } });
+            for (int i = 0; i < count; i++) rows.Add(LocalRow(source, id, i, "Message " + i));
+            File.WriteAllLines(path, rows.Select(row => row.ToString(Newtonsoft.Json.Formatting.None)));
+            return path;
+        }
+
+        private static JObject LocalRow(string source, string id, int index, string text)
+        {
+            var message = new JObject { ["role"] = index % 2 == 0 ? "user" : "assistant", ["content"] = new JArray(
+                new JObject { ["type"] = "text", ["text"] = text }, new JObject { ["type"] = "thinking", ["thinking"] = "hidden" }) };
+            var row = new JObject { ["timestamp"] = 1720000000000L + index * 86400000L };
+            if (source == "codex") { row["type"] = "response_item"; message["type"] = "message"; row["payload"] = message; }
+            else { row["type"] = (string)message["role"]; row["uuid"] = "row-" + index; row["sessionId"] = id; row["message"] = message; }
+            return row;
+        }
