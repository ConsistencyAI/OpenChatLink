+            _copyCode.AddToClassList("chat-v2-settings-action-button");
+            _copyCode.AddToClassList("chat-v2-external-copy-code");
+            connectionActions.Add(_copyCode); connectionRow.Add(connectionActions); _group.Add(connectionRow);
+            var section = root.Q<VisualElement>("chat-v2-settings-section-general");
+            if (section != null)
+            {
+                var anchor = section.Q<VisualElement>("chat-v2-settings-row-character-personality")
+                    ?? section.Q<VisualElement>("chat-v2-settings-row-user-display-name");
+                if (anchor?.parent == section) section.Insert(section.IndexOf(anchor) + 1, _group);
+                else section.Add(_group);
+            }
+            _banner = new VisualElement { name = "chat-v2-external-conversation-banner" };
+            _banner.AddToClassList("chat-v2-external-banner");
+            _bannerText = new Label(); _bannerText.AddToClassList("chat-v2-external-banner-text"); _banner.Add(_bannerText);
+            var actions = new VisualElement(); actions.AddToClassList("chat-v2-external-actions");
+            _continueHere = new Button(() => continueHere?.Invoke())
+                { text = Text("ChatV2_ExternalConversations_Continue_Key", "Continue in Phase Pal") };
+            actions.Add(_continueHere);
+            _openSource = new Button(() => { string url = _service?.GetSessionInfo(_sessionId)?.SourceUrl;
+                if (!string.IsNullOrEmpty(url)) Application.OpenURL(url); })
+                { text = "Open original" };
+            actions.Add(_openSource);
+            _viewOriginal = new Button(() => { string original = _service?.GetSessionInfo(_sessionId)?.OriginalSessionId;
+                if (!string.IsNullOrEmpty(original)) viewOriginal?.Invoke(original); })
+                { text = Text("ChatV2_ExternalConversations_ViewOriginal_Key", "View synced original") };
+            actions.Add(_viewOriginal); _banner.Add(actions);
+            root.Q<VisualElement>("chat-v2-composer-wrap")?.Insert(0, _banner);
+            _service.Changed += Refresh; Refresh();
+        }
+        public void ApplySession(string sessionId) { _sessionId = sessionId; Refresh(); }
+        private void Refresh()
+        {
+            if (_service == null) return;
+            _toggle?.SetValueWithoutNotify(_service.Enabled); _copyCode?.SetEnabled(_service.Ready);
+            if (_status != null) _status.text = _service.StatusText;
+            ChatV2ExternalConversationInfo info = _service.GetSessionInfo(_sessionId);
+            if (_banner == null) return;
+            _banner.style.display = info == null ? DisplayStyle.None : DisplayStyle.Flex;
+            if (info == null) return;
+            _bannerText.text = info.IsLocalCopy
+                ? "This is a local copy. Your recent messages cannot sync back to " + info.SourceName + ". You can continue here or view the synced original."
+                : "Synced from " + info.SourceName + ". Replies here stay in Phase Pal. Sending a message creates a local copy so the original can keep syncing.";
+            _openSource.text = "Open in " + info.SourceName;
+            _openSource.style.display = string.IsNullOrEmpty(info.SourceUrl) ? DisplayStyle.None : DisplayStyle.Flex;
+            _continueHere.style.display = info.IsLocalCopy ? DisplayStyle.None : DisplayStyle.Flex;
+            _viewOriginal.style.display = info.IsLocalCopy ? DisplayStyle.Flex : DisplayStyle.None;
+        }
+        public void Dispose()
+        {
+            if (_service != null) _service.Changed -= Refresh;
+            _group?.RemoveFromHierarchy(); _banner?.RemoveFromHierarchy();
+            _group = _banner = null; _service = null;
+        }
+    }
+}
