+        private static string Text(string key, string fallback) => ChatV2Localization.Resolve(key, fallback);
+        public void Bind(VisualElement root, IChatV2ExternalConversations service, Action<bool> toggle,
+            Action continueHere, Action<string> viewOriginal)
+        {
+            Dispose();
+            if (root == null || service == null) return;
+            _service = service;
+            _group = new VisualElement { name = "chat-v2-settings-external-conversations" };
+            _group.AddToClassList("chat-v2-external-settings");
+            var syncRow = new VisualElement { name = "chat-v2-settings-row-external-conversations" };
+            syncRow.AddToClassList("chat-v2-settings-row");
+            var syncCopy = new VisualElement { pickingMode = PickingMode.Ignore };
+            syncCopy.AddToClassList("chat-v2-settings-row__copy");
