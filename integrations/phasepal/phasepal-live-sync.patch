+// #Assets/_PhasePal/Scripts/Services/ChatV2/Platform/ChatV2ExternalConversationReceiver.cs
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Net;
+using System.Net.Sockets;
+using System.Text;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+
+namespace PhasePal.Services.ChatV2.Platform
+{
+    /// <summary>Bounded, authenticated loopback HTTP receiver; never invokes Unity APIs.</summary>
+    public sealed class ChatV2ExternalConversationReceiver : IDisposable
+    {
+        public const int PORT = 41771;
+        public const string PROTOCOL = "openchatlink/1";
+        private readonly TcpListener _listener = new TcpListener(IPAddress.Loopback, PORT);
+        private readonly CancellationTokenSource _lifetime = new CancellationTokenSource();
+        private readonly HashSet<TcpClient> _clients = new HashSet<TcpClient>();
+        private readonly HashSet<Task> _requests = new HashSet<Task>();
+        private readonly SemaphoreSlim _slots = new SemaphoreSlim(4, 4);
+        private readonly string _token;
+        private readonly Func<JObject, CancellationToken, Task<object>> _ingest;
+        private readonly Func<object> _health;
+        private Task _loop;
+        private int _stopped;
+
+        public ChatV2ExternalConversationReceiver(string token, Func<object> health,
+            Func<JObject, CancellationToken, Task<object>> ingest)
+        {
+            if (!Regex.IsMatch(token ?? string.Empty, "^[a-f0-9]{64}$")) throw new ArgumentException("Invalid connection credential.");
+            _token = token; _health = health; _ingest = ingest;
+        }
+
+        /// <summary>Starts bounded HTTP reception on the fixed IPv4 loopback port.</summary>
+        public void Start()
+        {
+            _listener.Start(4);
+            _loop = Task.Run(AcceptAsync);
+        }
+
+        private async Task AcceptAsync()
+        {
+            try
+            {
+                while (!_lifetime.IsCancellationRequested)
+                {
+                    await _slots.WaitAsync(_lifetime.Token).ConfigureAwait(false);
+                    TcpClient client;
+                    try { client = await _listener.AcceptTcpClientAsync().ConfigureAwait(false); }
+                    catch { _slots.Release(); throw; }
+                    lock (_clients) _clients.Add(client);
+                    Task request = HandleOwnedAsync(client);
+                    lock (_requests) _requests.Add(request);
+                    _ = request.ContinueWith(completed => {
+                        lock (_requests) _requests.Remove(completed);
+                        var ignored = completed.Exception;
+                    }, CancellationToken.None, TaskContinuationOptions.None, TaskScheduler.Default);
+                }
+            }
+            catch (Exception) when (_lifetime.IsCancellationRequested) { }
+        }
+
+        private async Task HandleOwnedAsync(TcpClient client)
+        {
+            using (client)
+            using (var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token))
+            {
+                cancellation.CancelAfter(TimeSpan.FromSeconds(60));
+                try { await HandleAsync(client.GetStream(), cancellation.Token).ConfigureAwait(false); }
+                catch (Exception) { /* Client disconnect, timeout, and invalid input close this request only. */ }
+                finally { lock (_clients) _clients.Remove(client); _slots.Release(); }
+            }
+        }
+
+        private async Task HandleAsync(NetworkStream stream, CancellationToken token)
+        {
+            var headerBytes = new List<byte>();
+            var one = new byte[1];
+            while (headerBytes.Count < 16384)
+            {
+                if (await stream.ReadAsync(one, 0, 1, token).ConfigureAwait(false) == 0) return;
+                headerBytes.Add(one[0]);
+                int count = headerBytes.Count;
+                if (count >= 4 && headerBytes[count - 4] == 13 && headerBytes[count - 3] == 10 &&
+                    headerBytes[count - 2] == 13 && headerBytes[count - 1] == 10) break;
+            }
+            if (headerBytes.Count >= 16384) return;
+            string[] lines = Encoding.ASCII.GetString(headerBytes.ToArray()).Split(new[] { "\r\n" }, StringSplitOptions.None);
+            string[] request = lines[0].Split(' ');
+            if (request.Length != 3 || request[2] != "HTTP/1.1") return;
+            var headers = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
+            for (int i = 1; i < lines.Length && lines[i].Length != 0; i++)
+            {
+                int colon = lines[i].IndexOf(':');
+                if (colon <= 0 || headers.ContainsKey(lines[i].Substring(0, colon))) return;
+                headers.Add(lines[i].Substring(0, colon), lines[i].Substring(colon + 1).Trim());
+            }
+            headers.TryGetValue("Origin", out string origin);
+            if (!headers.TryGetValue("Host", out string host) || host != "127.0.0.1:" + PORT ||
+                (!string.IsNullOrEmpty(origin) && !Regex.IsMatch(origin, "^chrome-extension://[a-p]{32}$")))
+            { await RespondAsync(stream, 403, new { error = "origin_rejected" }, null, token); return; }
+            if (request[0] == "OPTIONS")
+            {
+                if (string.IsNullOrEmpty(origin)) return;
+                await RespondAsync(stream, 200, new { protocol = PROTOCOL }, origin, token); return;
+            }
+            if (!headers.TryGetValue("Authorization", out string authorization) || !Authenticate(authorization))
+            { await RespondAsync(stream, 401, new { error = "connection_revoked" }, origin, token); return; }
+            if (request[0] == "GET" && request[1] == "/openchatlink/v1/health")
+            { await RespondAsync(stream, 200, _health(), origin, token); return; }
+            if (request[0] != "POST" || request[1] != "/openchatlink/v1/ingest" ||
+                headers.ContainsKey("Transfer-Encoding") || !headers.TryGetValue("Content-Length", out string rawLength) ||
+                !int.TryParse(rawLength, out int length) || length < 1 || length > 8 * 1024 * 1024 ||
+                !headers.TryGetValue("Content-Type", out string contentType) ||
+                !contentType.StartsWith("application/json", StringComparison.OrdinalIgnoreCase))
+            { await RespondAsync(stream, 413, new { error = "unsupported_request" }, origin, token); return; }
+            var body = new byte[length];
+            int offset = 0;
+            while (offset < length)
+            {
+                int count = await stream.ReadAsync(body, offset, length - offset, token).ConfigureAwait(false);
+                if (count == 0) return;
+                offset += count;
+            }
+            try
+            {
+                using (var text = new StringReader(new UTF8Encoding(false, true).GetString(body)))
+                using (var json = new JsonTextReader(text) { MaxDepth = 32 })
+                {
+                    JObject payload = JObject.Load(json);
+                    if (json.Read() || payload.Count != 1) throw new InvalidDataException();
+                    JObject conversation = payload["conversation"] as JObject ?? throw new InvalidDataException();
+                    object result = await _ingest(conversation, token).ConfigureAwait(false);
+                    await RespondAsync(stream, 200, result, origin, token).ConfigureAwait(false);
+                }
+            }
+            catch (OperationCanceledException) { throw; }
+            catch (Exception)
+            { await RespondAsync(stream, 400, new { error = "import_rejected" }, origin, token).ConfigureAwait(false); }
+        }
+
+        private bool Authenticate(string authorization)
+        {
+            string expected = "Bearer " + _token;
+            int difference = expected.Length ^ authorization.Length;
+            for (int i = 0; i < expected.Length; i++)
+                difference |= expected[i] ^ (i < authorization.Length ? authorization[i] : 0);
+            return difference == 0;
+        }
+
+        private static async Task RespondAsync(NetworkStream stream, int status, object result, string origin, CancellationToken token)
+        {
+            byte[] body = Encoding.UTF8.GetBytes(JsonConvert.SerializeObject(result));
+            string cors = string.IsNullOrEmpty(origin) ? string.Empty :
+                "Access-Control-Allow-Origin: " + origin + "\r\nVary: Origin\r\nAccess-Control-Allow-Headers: Authorization, Content-Type\r\n" +
+                "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\nAccess-Control-Allow-Private-Network: true\r\n";
+            byte[] header = Encoding.ASCII.GetBytes("HTTP/1.1 " + status + " Result\r\nContent-Type: application/json\r\n" +
+                "Content-Length: " + body.Length + "\r\nCache-Control: no-store\r\nConnection: close\r\n" + cors + "\r\n");
+            await stream.WriteAsync(header, 0, header.Length, token).ConfigureAwait(false);
+            await stream.WriteAsync(body, 0, body.Length, token).ConfigureAwait(false);
+        }
+
+        /// <summary>Closes clients immediately and drains pending requests asynchronously.</summary>
+        public void Dispose()
+        {
+            if (Interlocked.Exchange(ref _stopped, 1) != 0) return;
+            _lifetime.Cancel(); _listener.Stop();
+            lock (_clients) foreach (TcpClient client in _clients) client.Dispose();
+            _ = DrainAsync();
+        }
+
+        private async Task DrainAsync()
+        {
+            try
+            {
+                if (_loop != null) await _loop.ConfigureAwait(false);
+                Task[] requests;
+                lock (_requests) { requests = new Task[_requests.Count]; _requests.CopyTo(requests); }
+                await Task.WhenAll(requests).ConfigureAwait(false);
+            }
+            catch (Exception) { }
+            finally { _slots.Dispose(); _lifetime.Dispose(); }
+        }
+    }
+}
