+// #Assets/_PhasePal/Scripts/Services/ChatV2/Core/IChatV2ExternalConversations.cs
+using System;
+using System.Collections.Generic;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace PhasePal.Services.ChatV2.Core
+{
+    public sealed class ChatV2ExternalSyncNotice
+    {
+        public string Source { get; set; }
+        public bool Manual { get; set; }
+        public int Updated { get; set; }
+        public int Failures { get; set; }
+    }
+
+    /// <summary>Optional sync progress and completion feedback, independent of transcript ownership.</summary>
+    public interface IChatV2ExternalSyncFeedback
+    {
+        bool IsSyncing { get; }
+        IReadOnlyList<ChatV2ExternalSyncNotice> TakeSyncNotices();
+    }
+
+    public sealed class ChatV2ExternalConversationInfo
+    {
+        public string SessionId { get; set; }
+        public string CharacterId { get; set; }
+        public string OriginalSessionId { get; set; }
+        public string Source { get; set; }
+        public string SourceName { get; set; }
+        public string SourceUrl { get; set; }
+        public bool IsLocalCopy => !string.IsNullOrEmpty(OriginalSessionId);
+    }
+
+    public interface IChatV2ExternalConversations : IDisposable
+    {
+        event Action Changed;
+        bool Enabled { get; }
+        bool Ready { get; }
+        string StatusText { get; }
+        /// <summary>Returns a pairing code only while the authenticated receiver is ready.</summary>
+        string GetConnectionCode();
+        /// <summary>Returns source ownership and navigation information for a mirrored chat or local copy.</summary>
+        ChatV2ExternalConversationInfo GetSessionInfo(string sessionId);
+        /// <summary>Allows transcript writes only for native chats and independent local copies.</summary>
+        bool CanWriteSession(string sessionId);
+        /// <summary>Changes receiver availability for the selected avatar and current data scope.</summary>
+        Task SetEnabledAsync(bool enabled, string characterId, string characterName);
+        /// <summary>Copies a synced transcript into a new writable session without changing its source.</summary>
+        Task<string> CreateLocalCopyAsync(string sessionId, string characterId, CancellationToken cancellationToken);
+    }
+}
