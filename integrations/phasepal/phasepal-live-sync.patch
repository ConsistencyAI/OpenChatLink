+// #Assets/_PhasePal/Tests/Services/ChatV2/EditMode/ChatV2ExternalConversationTests.cs
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Net.Http;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json.Linq;
+using NUnit.Framework;
+using PhasePal.Services.ChatV2.Core;
+using PhasePal.Services.ChatV2.Platform;
+
+namespace PhasePal.Tests.ChatV2.EditMode
+{
+    public sealed class ChatV2ExternalConversationTests
+    {
+        private string _root;
+        private IChatV2HistoryStore _history;
+        private ChatV2ExternalConversationStore _store;
+
+        [SetUp]
+        public void SetUp()
+        {
+            _root = Path.Combine(Path.GetTempPath(), "OpenChatLinkTests_" + Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(_root);
+            _history = new ChatV2FileHistoryStore(Path.Combine(_root, "ChatV2History"), string.Empty);
+            _store = new ChatV2ExternalConversationStore(_history, _root);
+        }
+        [TearDown]
+        public void TearDown()
+        {
+            string resolved = Path.GetFullPath(_root);
+            string parent = Path.GetFullPath(Path.GetTempPath());
+            if (!resolved.StartsWith(parent, StringComparison.OrdinalIgnoreCase) ||
+                !Path.GetFileName(resolved).StartsWith("OpenChatLinkTests_", StringComparison.Ordinal))
+                throw new InvalidOperationException("Unexpected test directory.");
+            if (Directory.Exists(resolved)) Directory.Delete(resolved, true);
+        }
+        private static JObject Conversation(string reply = "こんにちは")
+            => new JObject {
+                ["source"] = "chatgpt", ["id"] = "00000000-0000-4000-8000-000000000001", ["accountId"] = "personal",
+                ["title"] = "Reina", ["updatedAt"] = 1720000100123L,
+                ["messages"] = new JArray(
+                    new JObject { ["index"] = 0, ["role"] = "user", ["text"] = "Hello | 🌸", ["createdAt"] = 1720000000123L },
+                    new JObject { ["index"] = 1, ["role"] = "assistant", ["text"] = reply, ["createdAt"] = 1720000001456L })
+            };
+
+        [TestCase(false)]
+        [TestCase(true)]
+        public async Task ImportsActualHistoryAndIdempotentRetry(bool global)
+        {
+            if (global)
+            {
+                _history = new ChatV2GlobalHistoryStore(Path.Combine(_root, "ChatV2History"));
+                _store = new ChatV2ExternalConversationStore(_history, _root);
+            }
+            var result = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            var rows = _history.LoadPage("avatar", result.SessionId, 10);
+            Assert.That(rows.Select(row => row.Text), Is.EqualTo(new[] { "Hello | 🌸", "こんにちは" }));
+            Assert.That(rows[0].CreatedAt.ToUnixTimeMilliseconds(), Is.EqualTo(1720000000123L));
+            Assert.That(_store.CanWrite(result.SessionId), Is.False);
+            var retry = await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            Assert.That(retry.SessionId, Is.EqualTo(result.SessionId));
+            Assert.That(retry.Changed, Is.False);
+            Assert.That(_history.LoadPage("avatar", result.SessionId, 10).Count, Is.EqualTo(2));
+            JObject corrected = Conversation();
+            corrected["messages"][0]["createdAt"] = 1720000000999L;
+            Assert.That((await _store.ImportAsync(corrected, "avatar", "Reina", CancellationToken.None)).Changed, Is.True);
+            Assert.That(_history.LoadPage("avatar", result.SessionId, 10)[0].CreatedAt.ToUnixTimeMilliseconds(), Is.EqualTo(1720000000999L));
+        }
+
+        private sealed class AfterImportHistory : IChatV2HistoryStore
+        {
+            private readonly IChatV2HistoryStore _inner;
+            public Action BeforeImport;
+            public Action AfterImport;
+            public AfterImportHistory(IChatV2HistoryStore inner) { _inner = inner; }
+            public string CurrentSessionId => _inner.CurrentSessionId;
+            public void SaveMessage(string character, string session, ChatV2Message message) => _inner.SaveMessage(character, session, message);
+            public bool UpdateMessage(string character, string session, ChatV2Message message) => _inner.UpdateMessage(character, session, message);
+            public bool DeleteMessage(string character, string session, ChatV2MessageId message) => _inner.DeleteMessage(character, session, message);
+            public bool TruncateFromMessage(string character, string session, ChatV2MessageId message) => _inner.TruncateFromMessage(character, session, message);
+            public IReadOnlyList<ChatV2Message> LoadPage(string character, string session, int size, string before = null) => _inner.LoadPage(character, session, size, before);
+            public IReadOnlyList<ChatV2SessionSummary> ListSessions(string character, int limit, string query = null) => _inner.ListSessions(character, limit, query);
+            public ChatV2SessionSummary GetLatestSessionSummary(string character) => _inner.GetLatestSessionSummary(character);
+            public ChatV2SessionSummary GetSessionSummary(string character, string session) => _inner.GetSessionSummary(character, session);
+            public bool ImportSession(string character, string session, string title, IReadOnlyList<ChatV2Message> messages, DateTimeOffset? modified = null, bool overwrite = false)
+            { BeforeImport?.Invoke(); bool result = _inner.ImportSession(character, session, title, messages, modified, overwrite); AfterImport?.Invoke(); return result; }
+            public bool DeleteSession(string character, string session) => _inner.DeleteSession(character, session);
+            public bool RenameSession(string character, string session, string title) => _inner.RenameSession(character, session, title);
+            public bool SetSessionPinned(string character, string session, bool pinned) => _inner.SetSessionPinned(character, session, pinned);
+        }
+
+        [TestCase(false, false, false)]
+        [TestCase(false, false, true)]
+        [TestCase(false, true, false)]
+        [TestCase(false, true, true)]
+        [TestCase(true, false, false)]
+        [TestCase(true, false, true)]
+        [TestCase(true, true, false)]
+        [TestCase(true, true, true)]
+        public async Task RegistryCommitFailureRecoversOriginalHomeAndSourceTitle(bool global, bool update, bool restart)
+        {
+            if (global) _history = new ChatV2GlobalHistoryStore(Path.Combine(_root, "ChatV2History"));
+            _store = new ChatV2ExternalConversationStore(_history, _root);
+            if (update) await _store.ImportAsync(Conversation(), "avatar", "Reina", CancellationToken.None);
+            string blocked = Path.Combine(_root, "Settings", "external_conversations.json.tmp");
