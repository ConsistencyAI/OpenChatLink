+// #Assets/_PhasePal/Scripts/Services/ChatV2/Platform/ChatV2ExternalConversationStore.cs
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+using Newtonsoft.Json;
+using Newtonsoft.Json.Linq;
+using PhasePal.Security;
+using PhasePal.Services.ChatV2.Core;
+
+namespace PhasePal.Services.ChatV2.Platform
+{
+    /// <summary>Owns source snapshots and isolated local copies. Call mutations on a history worker.</summary>
+    public sealed class ChatV2ExternalConversationStore
+    {
+        private readonly IChatV2HistoryStore _history;
+        private readonly string _statePath;
+        private readonly object _recordsGate = new object();
+        private readonly SemaphoreSlim _writer = new SemaphoreSlim(1, 1);
+        private Dictionary<string, Record> _records = new Dictionary<string, Record>(StringComparer.Ordinal);
+        private volatile bool _loaded;
+
+        public sealed class Record
+        {
+            public string SessionId, CharacterId, ChatGptId, AccountId, SourceTitle, HistoryHash, OriginalSessionId;
+            public bool Deleted;
+        }
+
+        public ChatV2ExternalConversationStore(IChatV2HistoryStore history, string persistentDataPath)
+        {
+            _history = history ?? throw new ArgumentNullException(nameof(history));
+            var paths = new PhasePalOwnedPathService(persistentDataPath);
+            if (!paths.TryResolveIdentifierDirectory("Settings", out string settings) ||
+                !paths.TryResolveDirectChildFile(settings, "external_conversations.json", out _statePath))
+                throw new IOException("External conversation settings path is unavailable.");
+        }
+
+        private void Load()
+        {
+            if (_loaded) return;
+            Dictionary<string, Record> loaded = new Dictionary<string, Record>(StringComparer.Ordinal);
+            if (File.Exists(_statePath))
+            {
+                var root = JObject.Parse(File.ReadAllText(_statePath));
+                if ((int?)root["schema"] != 1) throw new InvalidDataException("Unsupported external conversation state.");
+                loaded = root["records"]?.ToObject<Dictionary<string, Record>>() ??
+                    throw new InvalidDataException("External conversation state needs recovery.");
+            }
+            lock (_recordsGate)
+            {
+                if (_loaded) return;
+                _records = loaded;
+                _loaded = true;
+            }
+        }
+
+        private void Save()
+        {
+            Dictionary<string, Record> snapshot;
+            lock (_recordsGate) snapshot = new Dictionary<string, Record>(_records, StringComparer.Ordinal);
+            string json = JsonConvert.SerializeObject(new { schema = 1, records = snapshot });
+            Directory.CreateDirectory(Path.GetDirectoryName(_statePath));
+            string temporary = _statePath + ".tmp";
+            File.WriteAllText(temporary, json);
+            if (File.Exists(_statePath)) File.Replace(temporary, _statePath, _statePath + ".bak");
+            else File.Move(temporary, _statePath);
+        }
+
+        /// <summary>Loads ownership records on a history worker.</summary>
+        public void Initialize() => Load();
+
+        /// <summary>Reads cached ownership without disk access.</summary>
+        public ChatV2ExternalConversationInfo GetInfo(string sessionId)
+        {
+            lock (_recordsGate)
+            {
+                if (!_records.TryGetValue(sessionId ?? string.Empty, out Record record) || record.Deleted) return null;
+                return new ChatV2ExternalConversationInfo { SessionId = record.SessionId,
+                    CharacterId = record.CharacterId,
+                    OriginalSessionId = record.OriginalSessionId,
+                    ChatGptUrl = "https://chatgpt.com/c/" + record.ChatGptId };
+            }
+        }
+
+        /// <summary>Protects browser-owned transcripts, including before registry initialization.</summary>
+        public bool CanWrite(string sessionId)
+        {
+            sessionId = sessionId?.Trim() ?? string.Empty;
+            if (!_loaded && (sessionId ?? string.Empty).StartsWith("ocl-", StringComparison.Ordinal)) return false;
+            ChatV2ExternalConversationInfo info = GetInfo(sessionId);
+            return info == null ? !(sessionId ?? string.Empty).StartsWith("ocl-", StringComparison.Ordinal) : info.IsLocalCopy;
+        }
+
+        /// <summary>Computes the stable local identity hash.</summary>
+        public static string Hash(string value)
+        {
+            using (SHA256 algorithm = SHA256.Create())
+                return BitConverter.ToString(algorithm.ComputeHash(Encoding.UTF8.GetBytes(value))).Replace("-", "").ToLowerInvariant();
+        }
+
+        /// <summary>Identifies transcript changes that must not be overwritten by sync.</summary>
+        public static string Fingerprint(IReadOnlyList<ChatV2Message> messages)
+            => Hash(JsonConvert.SerializeObject(messages.Select(m => new {
+                id = m.Id.Value, role = (int)m.Role, m.Text, m.RawText, m.Reaction,
+                createdAt = m.CreatedAt.ToUnixTimeMilliseconds(),
+                attachment = (int)m.AttachmentKind, m.AttachmentUrl
+            })));
+
+        /// <summary>Validates ordered text messages and maps them to ChatV2 history records.</summary>
+        public static IReadOnlyList<ChatV2Message> ParseMessages(JObject conversation, string sessionId,
+            string characterId, string characterName)
+        {
+            var source = conversation["messages"] as JArray;
+            if (source == null || source.Count > 20000) throw new InvalidDataException("Invalid conversation messages.");
+            var result = new List<ChatV2Message>();
+            for (int i = 0; i < source.Count; i++)
+            {
+                JObject row = source[i] as JObject ?? throw new InvalidDataException("Invalid message.");
+                if (row["index"]?.Type != JTokenType.Integer || (int)row["index"] != i ||
+                    row["text"]?.Type != JTokenType.String || row["createdAt"]?.Type != JTokenType.Integer)
+                    throw new InvalidDataException("Invalid message fields.");
+                string role = (string)row["role"];
+                if (role != "user" && role != "assistant") throw new InvalidDataException("Unsupported message role.");
+                string text = (string)row["text"];
+                if (string.IsNullOrWhiteSpace(text)) continue;
+                DateTimeOffset createdAt = DateTimeOffset.FromUnixTimeMilliseconds((long)row["createdAt"]);
+                result.Add(new ChatV2Message(ChatV2MessageId.Create(sessionId + ":legacy-" + i),
+                    role == "user" ? ChatV2MessageRole.User : ChatV2MessageRole.Assistant, text, text,
+                    createdAt: createdAt, metadata: new Dictionary<string, string> {
+                        ["openchatlink.session"] = sessionId,
+                        [ChatV2CharacterMetadata.TURN_CHARACTER_ID] = characterId,
+                        [ChatV2CharacterMetadata.TURN_CHARACTER_NAME] = characterName ?? string.Empty
+                    }));
+            }
+            return result;
+        }
+
+        /// <summary>Imports an idempotent source snapshot unless it was deleted or changed locally.</summary>
+        public async Task<(string SessionId, bool Conflict, bool Accepted, bool Changed)> ImportAsync(
+            JObject conversation, string characterId, string characterName, CancellationToken token)
+        {
+            if (!PhasePalOwnedPathService.IsStrictIdentifier(characterId)) throw new InvalidDataException("Invalid target avatar.");
+            if (!Guid.TryParse((string)conversation["id"], out Guid id)) throw new InvalidDataException("Invalid ChatGPT identity.");
+            string account = (string)conversation["accountId"] ?? "personal";
+            if (account != "personal" && !Guid.TryParse(account, out _)) throw new InvalidDataException("Invalid account identity.");
+            string sid = "ocl-" + Hash(account + "\0" + id.ToString("D") + "\0" + characterId).Substring(0, 40);
+            string title = (string)conversation["title"] ?? "ChatGPT conversation";
+            if (title.Length > 300 || conversation["updatedAt"]?.Type != JTokenType.Integer)
+                throw new InvalidDataException("Invalid conversation metadata.");
+            DateTimeOffset updatedAt = DateTimeOffset.FromUnixTimeMilliseconds((long)conversation["updatedAt"]);
+            IReadOnlyList<ChatV2Message> incoming = ParseMessages(conversation, sid, characterId, characterName);
+            if (incoming.Count == 0) return (sid, false, false, false);
+            await _writer.WaitAsync(token).ConfigureAwait(false);
+            try
+            {
+                Load();
+                Record record;
+                lock (_recordsGate) _records.TryGetValue(sid, out record);
+                if (record?.Deleted == true) return (sid, false, false, false);
+                ChatV2SessionSummary summary = _history.GetSessionSummary(characterId, sid);
+                if (record != null && summary == null)
+                {
+                    lock (_recordsGate) record.Deleted = true;
+                    Save();
+                    return (sid, false, false, false);
+                }
+                IReadOnlyList<ChatV2Message> existing = summary == null ? Array.Empty<ChatV2Message>() :
+                    _history.LoadPage(characterId, sid, int.MaxValue);
+                string currentHash = Fingerprint(existing), incomingHash = Fingerprint(incoming);
+                // An identical retry can recover a completed file write whose registry save failed.
+                if (summary != null && currentHash != incomingHash &&
+                    (record == null || record.HistoryHash != currentHash))
+                    return (sid, true, false, false);
+                string chosenTitle = record != null && summary != null && summary.Title != record.SourceTitle
+                    ? summary.Title : title;
+                if (record != null && currentHash == incomingHash && record.SourceTitle == title)
+                    return (sid, false, true, false);
+                token.ThrowIfCancellationRequested();
+                if (currentHash != incomingHash || summary?.Title != chosenTitle)
+                {
+                    if (!_history.ImportSession(characterId, sid, chosenTitle, incoming, updatedAt, overwrite: true))
+                        throw new IOException("Conversation history could not be saved.");
+                }
+                lock (_recordsGate) _records[sid] = new Record { SessionId = sid, CharacterId = characterId,
+                    ChatGptId = id.ToString("D"), AccountId = account, SourceTitle = title, HistoryHash = incomingHash };
+                Save();
+                return (sid, false, true, true);
+            }
+            finally { _writer.Release(); }
+        }
+
+        /// <summary>Creates a writable transcript with independent session and message identities.</summary>
+        public async Task<string> CreateLocalCopyAsync(string sessionId, string characterId, CancellationToken token)
+        {
+            await _writer.WaitAsync(token).ConfigureAwait(false);
+            try
+            {
+                Load();
+                Record original;
+                lock (_recordsGate) _records.TryGetValue(sessionId, out original);
+                if (original == null || original.Deleted || !string.IsNullOrEmpty(original.OriginalSessionId)) return sessionId;
+                var messages = _history.LoadPage(original.CharacterId, sessionId, int.MaxValue);
+                if (messages.Count == 0) throw new IOException("The synced conversation is no longer available.");
+                string sid = Guid.NewGuid().ToString("D");
+                var copies = new List<ChatV2Message>(messages.Count);
+                foreach (ChatV2Message message in messages)
+                {
+                    var metadata = new Dictionary<string, string>();
+                    foreach (var item in message.Metadata)
+                        if (!item.Key.StartsWith("openchatlink.", StringComparison.Ordinal)) metadata[item.Key] = item.Value;
+                    copies.Add(new ChatV2Message(ChatV2MessageId.Create(Guid.NewGuid().ToString("D")),
+                        message.Role, message.Text, message.RawText, message.AttachmentKind,
+                        message.AttachmentUrl, message.AttachmentPreviewUrl, createdAt: message.CreatedAt,
+                        reaction: message.Reaction, origin: message.Origin, metadata: metadata,
+                        messageParts: message.MessageParts, attachments: message.Attachments));
+                }
+                token.ThrowIfCancellationRequested();
+                string title = (_history.GetSessionSummary(original.CharacterId, sessionId)?.Title ?? "ChatGPT conversation") + " (local copy)";
+                if (!_history.ImportSession(characterId, sid, title, copies, overwrite: true))
+                    throw new IOException("Local copy could not be saved.");
+                lock (_recordsGate) _records[sid] = new Record { SessionId = sid, CharacterId = characterId,
+                    ChatGptId = original.ChatGptId, AccountId = original.AccountId, OriginalSessionId = sessionId };
+                Save();
+                return sid;
+            }
+            finally { _writer.Release(); }
+        }
+    }
+}
