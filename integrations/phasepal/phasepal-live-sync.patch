+        private async void HandleExternalConversationCopy()
+        {
+            try { await PrepareExternalConversationAsync(); }
+            catch (Exception) { ShowExternalConversationError(); }
+        }
+
+        private Task<bool> PrepareExternalConversationAsync()
+        {
+            if (!isActiveAndEnabled) return Task.FromResult(false);
+            string original = _history?.Current?.SessionId;
+            ChatV2ExternalConversationInfo info = _externalConversations?.GetSessionInfo(original);
+            if (info == null || info.IsLocalCopy)
+                return Task.FromResult(_externalConversations?.CanWriteSession(original) ?? true);
+            if (_externalCopyTask == null || _externalCopyTask.IsCompleted)
+                _externalCopyTask = CreateExternalConversationCopyAsync(original);
+            return _externalCopyTask;
+        }
+
+        private async Task<bool> CreateExternalConversationCopyAsync(string original)
+        {
+            var cancellation = new CancellationTokenSource();
+            _externalCopyCancellation?.Cancel(); _externalCopyCancellation = cancellation;
+            string character = ResolveCurrentCharacterId();
+            try
+            {
+                string copy = await _externalConversations.CreateLocalCopyAsync(original, character, cancellation.Token);
+                if (cancellation.IsCancellationRequested || !isActiveAndEnabled ||
+                    _history.Current.SessionId != original || ResolveCurrentCharacterId() != character) return false;
+                var pending = new List<ChatV2Attachment>(_attachments.PendingItems);
+                bool opened = _historyCoordinator.TryOpenSession(copy, character);
+                if (opened) _attachments.ReplacePending(pending);
+                return opened;
+            }
+            catch (OperationCanceledException) { return false; }
+            catch (Exception) { ShowExternalConversationError(); return false; }
+            finally
+            {
+                if (ReferenceEquals(_externalCopyCancellation, cancellation)) _externalCopyCancellation = null;
+                cancellation.Dispose();
+            }
+        }
