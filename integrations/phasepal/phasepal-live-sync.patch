+        private VisualElement _group, _banner, _header, _headerOrigin, _boundRoot;
+        private Action _refreshHistoryOrigins;
+        private Action _playClickSound;
+        private Toggle _toggle;
+        private Label _status, _bannerText;
+        private Button _copyCode, _continueHere, _viewOriginal, _openSource;
+        private string _sessionId;
+        private string _sourceChannel;
+        private string _headerOriginalTooltip;
+        private VisualElement _syncIndicator;
+        private IVisualElementScheduledItem _syncAnimation;
+        public bool IsBound => _boundRoot != null;
+        private static string Text(string key, string fallback) => ChatV2Localization.Resolve(key, fallback);
+        public void Bind(VisualElement root, IChatV2ExternalConversations service, Action<bool> toggle,
+            Action continueHere, Action<string> viewOriginal, Action refreshHistoryOrigins = null, Action playClickSound = null)
+        {
+            Dispose();
+            if (root == null) return;
+            _boundRoot = root;
+            _service = service;
+            _refreshHistoryOrigins = refreshHistoryOrigins;
+            _playClickSound = playClickSound;
+            _header = root.Q<VisualElement>("chat-v2-header");
+            if (_header != null)
+            {
+                _headerOriginalTooltip = _header.tooltip;
+                _headerOrigin = ChatV2ConversationOriginBadge.Create("chat-v2-header-origin");
+                _headerOrigin.AddToClassList("chat-v2-origin--header");
+                _header.Add(_headerOrigin);
+                _header.AddToClassList("chat-v2-header--with-origin");
+            }
+            if (service == null) { Refresh(); return; }
+            var feedback = service as IChatV2ExternalSyncFeedback;
+            if (_header != null && feedback != null) {
+                _syncIndicator = new VisualElement { name = "chat-v2-external-sync-progress", pickingMode = PickingMode.Ignore,
+                    tooltip = Text("ChatV2_ExternalSync_Running_Key", "Syncing external conversations…") };
+                _syncIndicator.AddToClassList("chat-v2-external-sync-progress");
+                var spinner = new VisualElement { pickingMode = PickingMode.Ignore };
+                spinner.AddToClassList("chat-v2-history-item__replying-spinner");
+                _syncIndicator.Add(spinner); _headerOrigin.Add(_syncIndicator);
+                int frame = 0;
+                _syncAnimation = spinner.schedule.Execute(() => {
+                    frame = (frame + 1) % 8;
+                    spinner.style.rotate = new Rotate(new Angle(frame * 45f, AngleUnit.Degree));
+                }).Every(90);
+                _syncAnimation.Pause();
+            }
+            _group = new VisualElement { name = "chat-v2-settings-external-conversations" };
+            _group.AddToClassList("chat-v2-external-settings");
+            var syncRow = new VisualElement { name = "chat-v2-settings-row-external-conversations" };
+            syncRow.AddToClassList("chat-v2-settings-row");
+            var syncCopy = new VisualElement { pickingMode = PickingMode.Ignore };
+            syncCopy.AddToClassList("chat-v2-settings-row__copy");
+            var title = new Label(Text("ChatV2_ExternalConversations_Title_Key", "External Conversations"));
+            title.AddToClassList("chat-v2-settings-row__title"); syncCopy.Add(title);
+            var description = new Label(Text("ChatV2_ExternalConversations_Setup_Key",
+                "Load OpenChatLink in Chrome with Developer mode. Enable sync and copy the connection code. In the extension, choose ChatGPT, Claude, local Codex, or Claude Code and select your chats."));
+            description.AddToClassList("chat-v2-settings-row__description"); syncCopy.Add(description);
+            syncRow.Add(syncCopy);
+            _toggle = new Toggle(Text("ChatV2_ExternalConversations_EnableSources_Key", "Sync external conversations"))
+                { name = "chat-v2-settings-external-conversations-enabled" };
+            _toggle.AddToClassList("chat-v2-settings-toggle");
+            _toggle.RegisterValueChangedCallback(evt => { _playClickSound?.Invoke(); toggle?.Invoke(evt.newValue); }); syncRow.Add(_toggle);
+            _group.Add(syncRow);
+            var connectionRow = new VisualElement { name = "chat-v2-settings-row-external-conversation-connection" };
+            connectionRow.AddToClassList("chat-v2-settings-row");
+            var connectionCopy = new VisualElement { pickingMode = PickingMode.Ignore };
+            connectionCopy.AddToClassList("chat-v2-settings-row__copy");
+            var connectionTitle = new Label(Text("ChatV2_ExternalConversations_SourceConnection_Key", "OpenChatLink connection"));
+            connectionTitle.AddToClassList("chat-v2-settings-row__title"); connectionCopy.Add(connectionTitle);
+            _status = new Label(); _status.AddToClassList("chat-v2-settings-row__description"); connectionCopy.Add(_status);
+            connectionRow.Add(connectionCopy);
+            var connectionActions = new VisualElement(); connectionActions.AddToClassList("chat-v2-settings-actions");
+            _copyCode = new Button(() => { _playClickSound?.Invoke(); string code = _service?.GetConnectionCode();
+                if (!string.IsNullOrEmpty(code)) GUIUtility.systemCopyBuffer = code; })
+                { name = "chat-v2-settings-external-conversations-copy-code",
+                    text = Text("ChatV2_ExternalConversations_CopyCode_Key", "Copy connection code") };
+            _copyCode.AddToClassList("chat-v2-settings-action-button");
+            _copyCode.AddToClassList("chat-v2-external-copy-code");
+            connectionActions.Add(_copyCode); connectionRow.Add(connectionActions); _group.Add(connectionRow);
+            var section = root.Q<VisualElement>("chat-v2-settings-section-general");
+            if (section != null)
+            {
+                var anchor = section.Q<VisualElement>("chat-v2-settings-row-character-personality")
+                    ?? section.Q<VisualElement>("chat-v2-settings-row-user-display-name");
+                if (anchor?.parent == section) section.Insert(section.IndexOf(anchor) + 1, _group);
+                else section.Add(_group);
+            }
+            _banner = new VisualElement { name = "chat-v2-external-conversation-banner" };
+            _banner.AddToClassList("chat-v2-external-banner");
+            _bannerText = new Label(); _bannerText.AddToClassList("chat-v2-external-banner-text"); _banner.Add(_bannerText);
+            var actions = new VisualElement(); actions.AddToClassList("chat-v2-external-actions");
+            _continueHere = new Button(() => { _playClickSound?.Invoke(); continueHere?.Invoke(); })
+                { text = Text("ChatV2_ExternalConversations_Continue_Key", "Continue in Phase Pal") };
+            actions.Add(_continueHere);
+            _openSource = new Button(() => { _playClickSound?.Invoke(); string url = _service?.GetSessionInfo(_sessionId)?.SourceUrl;
+                if (!string.IsNullOrEmpty(url)) Application.OpenURL(url); })
+                { text = "Open original" };
+            actions.Add(_openSource);
+            _viewOriginal = new Button(() => { _playClickSound?.Invoke(); string original = _service?.GetSessionInfo(_sessionId)?.OriginalSessionId;
+                if (!string.IsNullOrEmpty(original)) viewOriginal?.Invoke(original); })
+                { text = Text("ChatV2_ExternalConversations_ViewOriginal_Key", "View synced original") };
+            actions.Add(_viewOriginal); _banner.Add(actions);
+            root.Q<VisualElement>("chat-v2-composer-wrap")?.Insert(0, _banner);
+            _service.Changed += Refresh; Refresh();
+        }
+        public void ApplySession(string sessionId, string sourceChannel = null)
+        { _sessionId = sessionId; _sourceChannel = sourceChannel; Refresh(); }
+        private void Refresh()
+        {
+            ChatV2ExternalConversationInfo info = _service?.GetSessionInfo(_sessionId);
+            bool syncing = (_service as IChatV2ExternalSyncFeedback)?.IsSyncing == true;
+            bool hasOrigin = info != null ||
+                string.Equals(_sourceChannel?.Trim(), "discord", StringComparison.OrdinalIgnoreCase) ||
+                string.Equals(_sourceChannel?.Trim(), "telegram", StringComparison.OrdinalIgnoreCase);
+            if (_headerOrigin != null)
+            {
+                ChatV2ConversationOriginBadge.Apply(_headerOrigin, info, _sourceChannel);
+                _headerOrigin.Q<Label>("source").style.display = hasOrigin ? DisplayStyle.Flex : DisplayStyle.None;
+                _headerOrigin.style.display = hasOrigin || syncing
+                    ? new StyleEnum<DisplayStyle>(StyleKeyword.Null)
+                    : new StyleEnum<DisplayStyle>(DisplayStyle.None);
+                _header.EnableInClassList("chat-v2-header--with-origin", hasOrigin || syncing);
+                _header.tooltip = hasOrigin ? _headerOrigin.tooltip : _headerOriginalTooltip;
+            }
+            _refreshHistoryOrigins?.Invoke();
+            if (_service == null) return;
+            if (_service is IChatV2ExternalSyncFeedback feedback) {
+                if (_syncIndicator != null) {
+                    _syncIndicator.style.display = feedback.IsSyncing ? DisplayStyle.Flex : DisplayStyle.None;
+                    if (feedback.IsSyncing) _syncAnimation?.Resume(); else _syncAnimation?.Pause();
+                }
+            }
+            _toggle?.SetValueWithoutNotify(_service.Enabled); _copyCode?.SetEnabled(_service.Ready);
+            if (_status != null) _status.text = _service.StatusText;
+            if (_banner == null) return;
+            _banner.style.display = info == null ? DisplayStyle.None : DisplayStyle.Flex;
+            if (info == null) return;
+            _bannerText.text = info.IsLocalCopy
+                ? "This is a local copy. Your recent messages cannot sync back to " + info.SourceName + ". You can continue here or view the synced original."
+                : "Synced from " + info.SourceName + ". Replies here stay in Phase Pal. Sending a message creates a local copy so the original can keep syncing.";
+            _openSource.text = "Open in " + info.SourceName;
+            _openSource.style.display = string.IsNullOrEmpty(info.SourceUrl) ? DisplayStyle.None : DisplayStyle.Flex;
+            _continueHere.style.display = info.IsLocalCopy ? DisplayStyle.None : DisplayStyle.Flex;
+            _viewOriginal.style.display = info.IsLocalCopy ? DisplayStyle.Flex : DisplayStyle.None;
+        }
+        public void Dispose()
+        {
+            _syncAnimation?.Pause(); _syncAnimation = null;
+            _syncIndicator?.RemoveFromHierarchy(); _syncIndicator = null;
+            if (_service != null) _service.Changed -= Refresh;
+            _group?.RemoveFromHierarchy(); _banner?.RemoveFromHierarchy();
+            _headerOrigin?.RemoveFromHierarchy();
+            _header?.RemoveFromClassList("chat-v2-header--with-origin");
+            if (_header != null) _header.tooltip = _headerOriginalTooltip;
+            _group = _banner = _header = _headerOrigin = _boundRoot = null; _service = null;
+            _refreshHistoryOrigins = null;
+            _playClickSound = null;
+        }
+    }
+
+    internal static class ChatV2ConversationOriginBadge
+    {
+        /// <summary>Creates non-interactive source and ownership labels shared by both chat surfaces.</summary>
+        public static VisualElement Create(string name)
+        {
+            var row = new VisualElement { name = name, pickingMode = PickingMode.Ignore };
+            row.AddToClassList("chat-v2-origin");
+            var source = new Label { name = "source", pickingMode = PickingMode.Ignore };
+            source.AddToClassList("chat-v2-origin__badge"); source.AddToClassList("chat-v2-origin__source");
+            var state = new Label { name = "state", pickingMode = PickingMode.Ignore };
+            state.AddToClassList("chat-v2-origin__badge"); state.AddToClassList("chat-v2-origin__state");
+            row.Add(source); row.Add(state);
+            return row;
+        }
+
+        /// <summary>Shows conversation origin independently from the selected reply provider.</summary>
+        public static void Apply(VisualElement row, ChatV2ExternalConversationInfo info, string sourceChannel)
+        {
+            string channel = sourceChannel?.Trim().ToLowerInvariant();
+            string source = info?.SourceName ?? (channel == "discord" ? "Discord" : channel == "telegram" ? "Telegram" : "Phase Pal");
+            string state = info == null ? string.Empty : info.IsLocalCopy
+                ? ChatV2Localization.Resolve("ChatV2_Origin_LocalCopy_Key", "Local copy")
+                : ChatV2Localization.Resolve("ChatV2_Origin_Synced_Key", "Synced");
+            row.Q<Label>("source").text = source;
+            Label stateLabel = row.Q<Label>("state"); stateLabel.text = state;
+            stateLabel.style.display = info == null ? DisplayStyle.None : DisplayStyle.Flex;
+            row.tooltip = info == null ? "Conversation origin: " + source
+                : info.IsLocalCopy ? "Continued in Phase Pal from " + source + ". Changes do not sync back."
+                : "Synced original from " + source + ". Continue in Phase Pal to create a local copy.";
+        }
+    }
+}
