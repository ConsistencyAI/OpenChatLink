@@ -0,0 +1,196 @@
+// #Assets/_PhasePal/Scripts/Services/ChatV2/Toolkit/ChatV2SharedSettingsPanelView.cs
+using UnityEngine;
+using UnityEngine.UIElements;
+using System;
+using System.Threading;
+using System.Threading.Tasks;
+using PhasePal.Services.ChatV2.Core;
+
+namespace PhasePal.Services.ChatV2.Toolkit
+{
+    /// <summary>Reuses the chat settings presentation in another document, without a composer or chat host.</summary>
+    public sealed class ChatV2SharedSettingsPanelView : IChatV2SettingsPanelView, IDisposable
+    {
+        private readonly VisualElement _root;
+        private readonly ChatV2KeyboardShortcutSettingsPresenter _shortcuts = new ChatV2KeyboardShortcutSettingsPresenter();
+        private readonly ChatV2ExternalConversationPresenter _external = new ChatV2ExternalConversationPresenter();
+        private readonly ChatV2DropdownStyleBridge _dropdowns = new ChatV2DropdownStyleBridge();
+        private readonly global::IHotkeyService _hotkeys;
+        private readonly Button _closeButton;
+        private readonly Button _libraryButton;
+        private readonly Label _status;
+        private IDisposable _localeSubscription;
+        private CancellationTokenSource _languageLifetime;
+        private bool _disposed;
+
+        public ChatV2SettingsPanelPresenter Presenter { get; } = new ChatV2SettingsPanelPresenter();
+        public bool IsSettingsPanelOpen => !_disposed && Presenter.IsOpen;
+        public bool IsDisposed => _disposed;
+        public event Action CloseRequested;
+        public event Action LibraryOptionsRequested;
+
+        /// <summary>Binds the existing settings template and its shared service-backed editors.</summary>
+        public ChatV2SharedSettingsPanelView(VisualElement root, global::IHotkeyService hotkeys,
+            IChatV2ExternalConversations externalConversations, Action<bool> toggleExternalConversations,
+            Action playClickSound = null)
+        {
+            _root = root ?? throw new ArgumentNullException(nameof(root));
+            _hotkeys = hotkeys;
+            VisualElement window = root.Q<VisualElement>("chat-v2-window");
+            VisualElement header = root.Q<VisualElement>("chat-v2-header");
+            VisualElement panel = root.Q<VisualElement>("chat-v2-settings-panel");
+            if (window == null || header == null || panel == null)
+                throw new InvalidOperationException("The shared settings template is incomplete.");
+
+            // Keep only settings presentation. No composer, transcript, or submit callbacks are hosted here.
+            header.RemoveFromHierarchy();
+            panel.RemoveFromHierarchy();
+            window.Clear();
+            window.Add(header);
+            window.Add(panel);
+            _status = new Label { name = "library-settings-status", pickingMode = PickingMode.Ignore };
+            _status.AddToClassList("library-settings-status");
+            _status.AddToClassList("chat-v2-settings-row__description");
+            _status.style.display = DisplayStyle.None;
+            window.Add(_status);
+            Presenter.Bind(root);
+            Presenter.BackRequested += RequestClose;
+            Presenter.McpApprovalSurfaceRequested += HandleMcpApproval;
+            _dropdowns.Bind(root, root);
+            root.RegisterCallback<KeyDownEvent>(HandleShortcutKeyDown, TrickleDown.TrickleDown);
+            root.RegisterCallback<KeyDownEvent>(HandleEscape);
+            if (externalConversations != null)
+                _external.Bind(root, externalConversations, toggleExternalConversations, null, null,
+                    playClickSound: playClickSound);
+
+            _closeButton = root.Q<Button>("chat-v2-close");
+            if (_closeButton != null) _closeButton.clicked += RequestClose;
+            _libraryButton = new Button(() => LibraryOptionsRequested?.Invoke())
+            {
+                name = "library-settings-library-options",
+                text = ChatV2Localization.Resolve("ChatV2_LibraryOptions_Key", "Library options")
+            };
+            _libraryButton.AddToClassList("chat-v2-settings-category");
+            root.Q<ScrollView>("chat-v2-settings-sidebar")?.contentContainer.Add(_libraryButton);
+            _localeSubscription = ChatV2Localization.RegisterSelectedLocaleChanged(_ => RefreshLocalization());
+            ChatV2Localization.StringsReady += RefreshLocalization;
+        }
+
+        private void RefreshLocalization()
+        {
+            if (_disposed) return;
+            Presenter.ApplyLocalization();
+            _libraryButton.text = ChatV2Localization.Resolve("ChatV2_LibraryOptions_Key", "Library options");
+            _shortcuts.Refresh();
+        }
+
+        private void RequestClose() => CloseRequested?.Invoke();
+
+        private void HandleMcpApproval(object sender, EventArgs args)
+        {
+            if (IsSettingsPanelOpen) ShowSettingsCategory(ChatV2SettingsCategory.Mcp);
+        }
+
+        private void HandleShortcutKeyDown(KeyDownEvent evt)
+        {
+            if (IsSettingsPanelOpen) _shortcuts.HandleKeyDown(evt);
+        }
+
+        private void HandleEscape(KeyDownEvent evt)
+        {
+            if (!IsSettingsPanelOpen || evt.keyCode != KeyCode.Escape) return;
+            evt.StopPropagation();
+            RequestClose();
+        }
+
+        public bool OpenSettingsPanel()
+        {
+            if (_disposed) return false;
+            _shortcuts.Bind(_root, _hotkeys);
+            bool opened = Presenter.Open();
+            _dropdowns.SyncShellClasses();
+            return opened;
+        }
+        public void CloseSettingsPanel()
+        {
+            _languageLifetime?.Cancel();
+            _shortcuts.Dispose();
+            Presenter.Close();
+            _dropdowns.SyncShellClasses();
+        }
+
+        public void ApplySettingsPanel(ChatV2SettingsPanelModel model)
+        {
+            if (_disposed) return;
+            Presenter.Apply(model);
+            if (model == null) return;
+            string theme = ChatV2ThemeCatalog.NormalizeThemeId(model.Theme);
+            _root.AddToClassList("chat-v2-theme-token-scope");
+            foreach (string id in ChatV2ThemeCatalog.ThemeIds)
+                _root.EnableInClassList("chat-v2-theme--" + id, string.Equals(id, theme, StringComparison.Ordinal));
+            bool light = ChatV2ThemeCatalog.TryGetDefinition(theme, out ChatV2ThemeDefinition definition) && definition.Palette.UsesLightBaseClass;
+            _root.EnableInClassList("chat-v2-scheme--light", light);
+            _root.EnableInClassList("chat-v2-scheme--dark", !light);
+            _root.style.fontSize = model.FontSize;
+            _dropdowns.SyncShellClasses();
+            _shortcuts.Refresh();
+        }
+
+        public void ApplySettingsMemory(ChatV2MemorySettingsModel model) { if (!_disposed) Presenter.ApplyMemorySettings(model); }
+        public void ApplySettingsBilling(ChatV2BillingSettingsModel model) { if (!_disposed) Presenter.ApplyBilling(model); }
+        public void ShowSettingsCategory(ChatV2SettingsCategory category) { if (!_disposed) Presenter.ShowCategory(category); }
+        public void RevealStoreChatHistorySetting() => Presenter.RevealStoreChatHistorySetting();
+        public void ApplyLanguageSelection(int index) => Presenter.ApplyLanguageSelection(index);
+
+        /// <summary>Shows settings feedback on the visible surface instead of the hidden chat shell.</summary>
+        public void ApplyStatus(ChatV2StatusEntry status)
+        {
+            if (_disposed) return;
+            bool visible = status != null && !status.IsEmpty &&
+                (status.Source == "settings" || status.Source == "external-conversation");
+            _status.text = visible ? status.Message : string.Empty;
+            _status.style.display = visible ? DisplayStyle.Flex : DisplayStyle.None;
+        }
+
+        public async Task<bool> RunLanguageChangeAsync(Func<CancellationToken, Task> changeLanguage)
+        {
+            if (_disposed || _languageLifetime != null) return false;
+            var lifetime = new CancellationTokenSource();
+            _languageLifetime = lifetime;
+            try
+            {
+                await changeLanguage(lifetime.Token);
+                if (_disposed || lifetime.IsCancellationRequested) return false;
+                Presenter.ApplyLocalization();
+                _shortcuts.Refresh();
+                return true;
+            }
+            catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { return false; }
+            finally
+            {
+                if (ReferenceEquals(_languageLifetime, lifetime)) _languageLifetime = null;
+                lifetime.Dispose();
+            }
+        }
+
+        public void Dispose()
+        {
+            if (_disposed) return;
+            _disposed = true;
+            ChatV2Localization.StringsReady -= RefreshLocalization;
+            _localeSubscription?.Dispose();
+            _localeSubscription = null;
+            _languageLifetime?.Cancel();
+            Presenter.BackRequested -= RequestClose;
+            Presenter.McpApprovalSurfaceRequested -= HandleMcpApproval;
+            if (_closeButton != null) _closeButton.clicked -= RequestClose;
+            _libraryButton.RemoveFromHierarchy();
+            _shortcuts.Dispose();
+            _root.UnregisterCallback<KeyDownEvent>(HandleShortcutKeyDown, TrickleDown.TrickleDown);
+            _root.UnregisterCallback<KeyDownEvent>(HandleEscape);
+            _dropdowns.Dispose();
+            _external.Dispose();
+            Presenter.Dispose();
+        }
+    }
+}
