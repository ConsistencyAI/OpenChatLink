+        [Test]
+        public async Task ReceiverRequiresTokenAndRejectsWebOrigins()
+        {
+            string credential = new string('a', 64);
+            using (var receiver = new ChatV2ExternalConversationReceiver(credential,
+                () => new { protocol = ChatV2ExternalConversationReceiver.PROTOCOL },
+                async (body, token) => {
+                    var result = await _store.ImportAsync(body, "avatar", "Reina", token);
+                    return new { protocol = ChatV2ExternalConversationReceiver.PROTOCOL, accepted = result.Accepted };
+                }))
+            using (var client = new HttpClient())
+            {
+                receiver.Start();
+                string endpoint = "http://127.0.0.1:41771/openchatlink/v1/health";
+                using (HttpResponseMessage unauthenticated = await client.GetAsync(endpoint))
+                    Assert.That((int)unauthenticated.StatusCode, Is.EqualTo(401));
+                using (var request = new HttpRequestMessage(HttpMethod.Get, endpoint))
+                {
+                    request.Headers.TryAddWithoutValidation("Authorization", "Bearer " + credential);
+                    request.Headers.TryAddWithoutValidation("Origin", "https://example.com");
+                    using (var response = await client.SendAsync(request))
+                        Assert.That((int)response.StatusCode, Is.EqualTo(403));
+                }
+                using (var request = new HttpRequestMessage(HttpMethod.Get, endpoint))
+                {
+                    request.Headers.TryAddWithoutValidation("Authorization", "Bearer " + credential);
+                    request.Headers.TryAddWithoutValidation("Origin", "chrome-extension://" + new string('a', 32));
+                    using (var response = await client.SendAsync(request))
+                        Assert.That((int)response.StatusCode, Is.EqualTo(200));
+                }
+                client.DefaultRequestHeaders.TryAddWithoutValidation("Authorization", "Bearer " + credential);
+                string ingest = "http://127.0.0.1:41771/openchatlink/v1/ingest";
+                using (var body = new StringContent(new JObject { ["conversation"] = Conversation() }.ToString(), Encoding.UTF8, "application/json"))
+                using (var response = await client.PostAsync(ingest, body))
+                {
+                    Assert.That((int)response.StatusCode, Is.EqualTo(200));
+                    Assert.That((bool)JObject.Parse(await response.Content.ReadAsStringAsync())["accepted"], Is.True);
+                }
+                Assert.That(_history.ListSessions("avatar", 10).Count, Is.EqualTo(1));
+                using (var body = new StringContent("{\"conversation\":{}} {}", Encoding.UTF8, "application/json"))
+                using (var response = await client.PostAsync(ingest, body))
+                    Assert.That((int)response.StatusCode, Is.EqualTo(400));
+            }
+        }
+
+        private sealed class Secrets : IChatV2ExternalMemorySecretStore
+        {
+            public bool IsAvailable { get; set; } = true;
+            public string Secret = new string('b', 64);
+            public TaskCompletionSource<ChatV2ExternalMemorySecretLoadResult> Pending;
+            public readonly TaskCompletionSource<bool> LoadStarted = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
+            public Task<ChatV2ExternalMemorySecretLoadResult> LoadAsync()
+            {
+                LoadStarted.TrySetResult(true);
+                return Pending?.Task ?? Task.FromResult(new ChatV2ExternalMemorySecretLoadResult(true, Secret));
+            }
+            public Task<bool> SaveAsync(string secret) { Secret = secret; return Task.FromResult(true); }
+            public Task<bool> DeleteAsync() { Secret = null; return Task.FromResult(true); }
+        }
+
+        [Test]
+        public async Task ServicePairsAndRevokesWithoutPlaintextFallback()
+        {
+            var secrets = new Secrets();
+            using (var service = new ChatV2ExternalConversationService(_history, _root, secrets))
+            {
+                await service.ResumeAsync(true);
+                Assert.That(service.Enabled, Is.False);
+                await service.SetEnabledAsync(true, "avatar", "Reina");
+                Assert.That(service.Ready, Is.True);
+                Assert.That(service.GetConnectionCode().StartsWith("ocl1."), Is.True);
+                service.Tick(false);
+                await service.ResumeAsync(false);
+                Assert.That(service.Enabled, Is.True);
+                Assert.That(service.Ready, Is.False);
+                await service.ResumeAsync(true);
+                Assert.That(service.Ready, Is.True);
+                await service.SetEnabledAsync(false, "avatar", "Reina");
+                Assert.That(service.GetConnectionCode(), Is.Empty);
+                Assert.That(service.Ready, Is.False);
+                Assert.That(secrets.Secret, Is.Null);
+            }
+        }
